---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CloseCta from '../../components/sections/CloseCta.astro';

export async function getStaticPaths() {
  const studies = await getCollection('caseStudies', ({ data }) => !data.draft);
  return studies.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;

const description = data.description ?? data.summary;
const url = `https://bestcasestud.io/case-studies/${entry.id}/`;

const articleSchema = {
  '@type': 'Article',
  '@id': `${url}#article`,
  headline: data.title,
  description,
  inLanguage: 'en',
  url,
  mainEntityOfPage: url,
  datePublished: data.publishedAt.toISOString(),
  ...(data.updatedAt && { dateModified: data.updatedAt.toISOString() }),
  ...(data.heroImage && { image: `https://bestcasestud.io${data.heroImage}` }),
  publisher: { '@id': 'https://bestcasestud.io/#org' },
  author: { '@id': 'https://bestcasestud.io/#jon' },
  about: {
    '@type': 'Organization',
    name: data.customer,
    ...(data.customerLogo && { logo: `https://bestcasestud.io${data.customerLogo}` }),
  },
  keywords: data.tags.join(', '),
};
---

<Base title={`${data.title} · Best Case Studio`} description={description} schema={[articleSchema]}>
  <article class="study">
    <header class="study-head">
      <div class="wrap">
        <p class="eyebrow mono">Case study · {data.customer}</p>
        <h1>{data.title}</h1>
        <p class="lede">{data.summary}</p>
        {data.heroImage && (
          <img class="hero" src={data.heroImage} alt={`${data.customer} case study cover`} loading="eager" />
        )}
      </div>
    </header>
    <section class="body">
      <div class="wrap-tight">
        <Content />
      </div>
    </section>
  </article>
  <CloseCta />
</Base>

<style>
  .study-head {
    background: var(--bg);
    padding: 160px 0 64px;
    border-bottom: 1px solid var(--rule);
  }
  .eyebrow {
    color: var(--ink-soft);
    margin: 0 0 24px;
  }
  h1 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(40px, 5.5vw, 88px);
    line-height: 1;
    letter-spacing: -0.025em;
    margin: 0 0 24px;
    max-width: 22ch;
  }
  .lede {
    font-size: 22px;
    line-height: 1.45;
    max-width: 64ch;
    margin: 0 0 48px;
  }
  .hero {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--ink);
  }
  .body {
    padding: 80px 0 120px;
    font-size: 18px;
    line-height: 1.65;
  }
  .body :global(h2) {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(28px, 3vw, 40px);
    margin: 56px 0 20px;
  }
  .body :global(h3) {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 22px;
    margin: 40px 0 12px;
  }
  .body :global(blockquote) {
    border-left: 3px solid var(--ink);
    margin: 32px 0;
    padding: 8px 0 8px 24px;
    font-family: var(--serif);
    font-style: italic;
    font-size: 22px;
    line-height: 1.4;
  }
</style>
