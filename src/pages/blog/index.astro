---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

function formatDate(d: Date) {
  return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
}
---

<Base
  title="Blog · Best Case Studio"
  description="Guides, pricing breakdowns, and sharp takes on B2B case studies, SEO, and getting cited by AI."
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Blog', url: '/blog/' },
  ]}
>
  <section class="blog-intro">
    <div class="wrap-article">
      <p class="eyebrow mono">Blog</p>
      <h1>Guides &amp; sharp takes</h1>
      <p class="lede">On B2B case studies, SEO, and getting cited by AI.</p>
    </div>
  </section>

  <section class="blog-list">
    <div class="wrap-article">
      {posts.map((post) => (
        <a href={`/blog/${post.id}/`} class="post-card">
          <time class="mono" datetime={post.data.date.toISOString().slice(0, 10)}>
            {formatDate(post.data.date)}
          </time>
          <h2>{post.data.title}</h2>
          <p>{post.data.description}</p>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .blog-intro {
    padding: 160px 0 48px;
  }
  .eyebrow {
    color: var(--ink-soft);
    margin: 0 0 20px;
  }
  .blog-intro h1 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(36px, 5vw, 56px);
    line-height: 1.04;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
  }
  .lede {
    font-size: 20px;
    line-height: 1.5;
    color: var(--ink-soft);
    font-style: italic;
    margin: 0;
  }

  .blog-list {
    padding: 0 0 120px;
    border-top: 1px solid var(--rule);
  }
  .post-card {
    display: block;
    padding: 32px 0;
    border-bottom: 1px solid var(--rule);
  }
  .post-card:hover h2 {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1.5px;
  }
  .post-card time {
    color: var(--ink-soft);
    display: block;
    margin-bottom: 10px;
  }
  .post-card h2 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(22px, 2.6vw, 28px);
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin: 0 0 8px;
  }
  .post-card p {
    font-size: 17px;
    line-height: 1.5;
    color: var(--ink-soft);
    margin: 0;
    max-width: 60ch;
  }

  @media (max-width: 900px) {
    .blog-intro {
      padding-top: 120px;
    }
  }
</style>
