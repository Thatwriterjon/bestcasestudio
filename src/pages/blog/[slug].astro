---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);

const dateStr = post.data.date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const isoDate = post.data.date.toISOString();

/* ---- JSON-LD: Article ---- */
const articleSchema: Record<string, unknown> = {
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  author: {
    '@type': 'Person',
    '@id': 'https://bestcasestud.io/#jon',
    name: post.data.author,
  },
  publisher: { '@id': 'https://bestcasestud.io/#org' },
  datePublished: isoDate,
  mainEntityOfPage: `https://bestcasestud.io/blog/${post.id}/`,
};
if (post.data.updated) {
  articleSchema.dateModified = post.data.updated.toISOString();
}

/* ---- JSON-LD: FAQPage (if frontmatter has faq items) ---- */
const faqSchema: Record<string, unknown> | null = post.data.faq?.length
  ? {
      '@type': 'FAQPage',
      mainEntity: post.data.faq.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    }
  : null;

const schemas = [articleSchema, ...(faqSchema ? [faqSchema] : [])];
---

<Base
  title={`${post.data.title} · Best Case Studio`}
  description={post.data.description}
  ogType="article"
  schema={schemas}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Blog', url: '/blog/' },
    { name: post.data.title, url: `/blog/${post.id}/` },
  ]}
>
  <article class="post">
    <header class="post-header">
      <div class="wrap-article">
        <a href="/blog/" class="back mono">← Blog</a>
        <h1>{post.data.title}</h1>
        <div class="post-meta mono">
          <span>{post.data.author}</span>
          <span aria-hidden="true">·</span>
          <time datetime={isoDate}>{dateStr}</time>
        </div>
      </div>
    </header>

    <div class="post-body">
      <div class="wrap-article prose">
        <Content />
      </div>
    </div>

    {post.data.faq && post.data.faq.length > 0 && (
      <section class="post-faq">
        <div class="wrap-article">
          <h2>Frequently asked questions</h2>
          <dl class="faq-list">
            {post.data.faq.map((item) => (
              <div class="faq-item">
                <dt>{item.q}</dt>
                <dd>{item.a}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    )}

    <section class="post-cta">
      <div class="wrap-article">
        <div class="cta-box">
          <h3>Want a case study that earns its&nbsp;keep?</h3>
          <p>
            Book a free 30-minute discovery call. We'll audit one of your existing case studies
            live — no pitch, no obligation.
          </p>
          <a href="/contact/" class="cta-btn">Book a free audit →</a>
        </div>
      </div>
    </section>
  </article>
</Base>

<style>
  /* ---- Header ---- */
  .post-header {
    padding: 160px 0 48px;
  }
  .back {
    display: inline-block;
    color: var(--ink-soft);
    margin-bottom: 32px;
  }
  .back:hover {
    color: var(--ink);
  }
  .post-header h1 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(32px, 4.5vw, 52px);
    line-height: 1.06;
    letter-spacing: -0.02em;
    margin: 0 0 24px;
    max-width: 20ch;
  }
  .post-meta {
    color: var(--ink-soft);
    display: flex;
    gap: 10px;
  }

  /* ---- Prose (Markdown body) ---- */
  .post-body {
    padding-bottom: 64px;
  }

  .prose :global(h2) {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(24px, 2.8vw, 32px);
    line-height: 1.12;
    letter-spacing: -0.015em;
    margin: 56px 0 20px;
  }
  .prose :global(h3) {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 20px;
    line-height: 1.3;
    margin: 40px 0 12px;
  }
  .prose :global(p) {
    font-size: 19px;
    line-height: 1.62;
    margin: 0 0 18px;
  }
  .prose :global(ul),
  .prose :global(ol) {
    font-size: 19px;
    line-height: 1.62;
    margin: 0 0 18px;
    padding-left: 24px;
  }
  .prose :global(li) {
    margin-bottom: 8px;
  }
  .prose :global(li):last-child {
    margin-bottom: 0;
  }
  .prose :global(strong) {
    font-weight: 600;
  }
  .prose :global(em) {
    font-style: italic;
  }
  .prose :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--ink-faint);
  }
  .prose :global(a:hover) {
    text-decoration-color: var(--ink);
  }
  .prose :global(blockquote) {
    margin: 28px 0;
    padding: 4px 0 4px 24px;
    border-left: 3px solid var(--pink);
  }
  .prose :global(blockquote p) {
    font-style: italic;
    color: var(--ink-soft);
  }
  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--rule);
    margin: 48px 0;
  }
  .prose :global(code) {
    font-family: var(--mono);
    font-size: 14px;
    background: var(--bg-2);
    padding: 2px 6px;
    border-radius: 4px;
  }

  /* ---- Table ---- */
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 24px 0 28px;
    font-size: 15px;
    line-height: 1.45;
  }
  .prose :global(thead) {
    border-bottom: 2px solid var(--ink);
  }
  .prose :global(th) {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
    text-align: left;
    padding: 10px 14px 10px 0;
    white-space: nowrap;
  }
  .prose :global(td) {
    padding: 10px 14px 10px 0;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
  }
  .prose :global(tr td:first-child) {
    font-weight: 600;
    font-size: 14px;
    white-space: nowrap;
  }

  /* ---- FAQ ---- */
  .post-faq {
    padding: 56px 0 48px;
    border-top: 1px solid var(--rule);
  }
  .post-faq h2 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(24px, 2.8vw, 32px);
    line-height: 1.12;
    letter-spacing: -0.015em;
    margin: 0 0 32px;
  }
  .faq-list {
    margin: 0;
  }
  .faq-item {
    padding: 24px 0;
    border-top: 1px solid var(--rule);
  }
  .faq-item:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .faq-item dt {
    font-weight: 600;
    font-size: 18px;
    line-height: 1.4;
    margin-bottom: 8px;
  }
  .faq-item dd {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  /* ---- CTA ---- */
  .post-cta {
    padding: 0 0 120px;
  }
  .cta-box {
    background: var(--ink);
    color: var(--bg);
    border-radius: 8px;
    padding: 48px;
    text-align: center;
  }
  .cta-box h3 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(24px, 3vw, 34px);
    line-height: 1.1;
    letter-spacing: -0.015em;
    margin: 0 0 16px;
    color: var(--bg);
  }
  .cta-box p {
    font-size: 17px;
    line-height: 1.55;
    color: #c8c3b6;
    margin: 0 0 28px;
    max-width: 48ch;
    margin-left: auto;
    margin-right: auto;
  }
  .cta-btn {
    display: inline-block;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 500;
    background: var(--bg);
    color: var(--ink);
    padding: 14px 28px;
    border-radius: 999px;
    text-decoration: none;
  }
  .cta-btn:hover {
    background: var(--pink);
  }

  @media (max-width: 900px) {
    .post-header {
      padding-top: 120px;
    }
    .cta-box {
      padding: 32px 24px;
    }
  }
</style>
