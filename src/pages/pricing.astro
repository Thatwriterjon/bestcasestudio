---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import MobileCta from '../components/MobileCta.astro';
import CloseCta from '../components/sections/CloseCta.astro';

const included = [
  'Video case study — the full story, on camera, in your customer\'s own words',
  'Written case study — built to rank on Google and get cited by AI',
  'Video testimonial — a short, sharp cut for your homepage and socials',
  'Written testimonial — a pull-quote for your site, deck, and emails',
  'Social pack — LinkedIn carousel and short clips',
  'A "how to use it" guide — where each piece does the most damage',
];

const comparison = [
  { option: 'DIY / AI tools', cost: '$0–$500', get: 'Written only, no interview', highlight: false },
  { option: 'Freelance writer', cost: '$1,000–$2,500', get: 'Written only', highlight: false },
  { option: 'Written specialist', cost: '$1,500–$3,000', get: 'Written, video as paid add-on', highlight: false },
  { option: 'The Proof Kit', cost: '$2,500', get: 'Video + written + both testimonials + social pack', highlight: true },
  { option: 'Premium video production', cost: '$6,000+', get: 'Video, often annual commitment', highlight: false },
  { option: 'Full-service agency', cost: '$5,000–$15,000+', get: 'Video, long engagement', highlight: false },
];

/* Commercial-mechanics FAQ — distinct from the homepage's objection-handling set. Single source
 * of truth: the visible <details> and the FAQPage JSON-LD below are both built from this array,
 * so they always match verbatim. */
const faq = [
  {
    q: 'Is $2,500 really everything? No upsells?',
    a: 'Everything. One price, one complete kit — video case study, written case study, both testimonials, social pack, and the guide. The only thing you\'ll spend after is the ten minutes it takes to post it.',
  },
  {
    q: 'How long does it take?',
    a: '14 days from the interview. The clock starts when your customer\'s in the chair, so the only variable is how fast you make the intro.',
  },
  {
    q: 'How many rounds of revisions?',
    a: 'One consolidated round from you — and if your customer wants changes after they review it, we make those too. Your customer\'s comfort matters more than our process. Nobody ends up published saying something they\'d rather they hadn\'t.',
  },
  {
    q: 'What are the payment terms?',
    a: 'Half up front to book the slot, half when your first drafts land. The second payment is triggered by our delivery, not your sign-off — so you\'re never paying for work you haven\'t seen, and we\'re never chasing you for feedback before we can invoice.',
  },
  {
    q: 'Do you do volume pricing?',
    a: 'Yes — there\'s a discount from three Proof Kits onward. Most founders start with one, see how it lands, then line up the next two. Ask on the call.',
  },
  {
    q: 'Why $2,500 and not $6,000?',
    a: 'Premium video studios price for enterprise marketing teams and usually want an annual commitment. The Proof Kit is one fixed price, one conversation, no contract — built for founders who want proof this quarter, not a procurement cycle.',
  },
];

const offerSchema = {
  '@type': 'Service',
  '@id': 'https://bestcasestud.io/#service',
  name: 'The Proof Kit',
  serviceType: 'B2B case study production',
  provider: { '@id': 'https://bestcasestud.io/#org' },
  areaServed: 'Worldwide',
  url: 'https://bestcasestud.io/pricing/',
  description:
    'One recorded customer conversation becomes a complete B2B case study — video, written, testimonials, and a social pack. $2,500, delivered 14 days from the interview.',
  offers: [
    {
      '@type': 'Offer',
      name: 'The Proof Kit',
      price: '2500',
      priceCurrency: 'USD',
      url: 'https://bestcasestud.io/pricing/',
      availability: 'https://schema.org/InStock',
      category: 'Marketing services',
    },
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'What\'s included in the Proof Kit',
    itemListElement: [
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Video case study', description: 'The full story, on camera, in your customer\'s own words.' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Written case study', description: 'The deep-dive version, built to rank on Google and get cited by AI.' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Video testimonial', description: 'A short cut for your homepage and socials.' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Written testimonial', description: 'A pull-quote for your site, deck, and emails.' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Social pack', description: 'LinkedIn carousel and short clips.' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Launch checklist', description: 'Where each piece works hardest.' } },
    ],
  },
};

const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Base
  title="Pricing · The Proof Kit, $2,500 · Best Case Studio"
  description="One package, one price: $2,500 for a complete B2B case study — video, written, testimonials, and a social pack, delivered 14 days from the interview."
  schema={[offerSchema, faqSchema]}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Pricing', url: '/pricing/' },
  ]}
>
  <section class="pricing-intro">
    <div class="wrap">
      <p class="eyebrow mono">Pricing</p>
      <h1>
        The Proof Kit: a complete B2B case study for <em>$2,500.</em>
      </h1>
      <MobileCta />
    </div>
  </section>

  <section class="pricing-offers">
    <div class="wrap">
      <div class="pricing-grid">
        <div class="pricing-card featured">
          <div class="pricing-inner">
            <span class="card-eyebrow"><span class="pip" aria-hidden="true"></span>The Proof Kit</span>
            <h2>Everything, <em>from one conversation.</em></h2>
            <p class="price-lede">One recorded conversation with your best customer, delivered as a complete proof set.</p>
            <div class="price-spacer"></div>
            <div class="price-row">
              <span class="price">$2,500</span>
            </div>
            <span class="delivery-badge">Delivered 14 days from the interview</span>
            <p class="frame-note">One complete kit, cut from one conversation. Here's every piece.</p>
            <div class="included">
              <h3>What's included</h3>
              <ul>
                {included.map((item: string) => (
                  <li><span>{item}</span></li>
                ))}
              </ul>
            </div>
            <p class="trade-note">Buy proof anywhere else in pieces and you'll spend $7,000–$10,000 before you've got a fraction of this. We productised the whole thing so you don't have to.</p>
            <Button href="/contact/" variant="primary">Book a call</Button>
          </div>
        </div>
      </div>

      <p class="bottom-note">
        Questions? <a href="/contact/">Get in touch</a>.
      </p>
    </div>
  </section>

  <section class="cost-compare">
    <div class="wrap">
      <h2>What a B2B case study costs in 2026</h2>
      <div class="table-wrap">
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th scope="col">Option</th>
                <th scope="col">Typical cost</th>
                <th scope="col">What you get</th>
              </tr>
            </thead>
            <tbody>
              {comparison.map((row) => (
                <tr class:list={[row.highlight && 'is-kit']}>
                  <th scope="row">{row.option}</th>
                  <td>{row.cost}</td>
                  <td>{row.get}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
      <p class="table-hint" aria-hidden="true">Swipe to see all columns →</p>
      <p class="table-note">
        Want the detail behind these numbers? Read <a href="/blog/how-much-does-a-b2b-case-study-cost/">the full breakdown of what a B2B case study costs</a>.
      </p>
    </div>
  </section>

  <section id="faq" class="pricing-faq">
    <div class="wrap-tight">
      <h2 class="faq-head">Frequently asked <em>questions</em>.</h2>
      <p class="faq-lede">Everything you need to know before you book.</p>
      <div class="faq-list">
        {faq.map((item) => (
          <details class="q">
            <summary>
              <span>{item.q}</span>
              <span class="marker" aria-hidden="true">+</span>
            </summary>
            <div class="a">
              <p>{item.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CloseCta />
</Base>

<style>
  /* Intro */
  .pricing-intro {
    background: var(--bg);
    padding: 180px 0 80px;
    border-bottom: 1px solid var(--rule);
  }
  .eyebrow {
    color: var(--ink-soft);
    margin: 0 0 24px;
  }
  h1 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(44px, 6vw, 92px);
    line-height: 0.98;
    letter-spacing: -0.025em;
    margin: 0 0 28px;
    max-width: 20ch;
  }
  h1 em {
    font-style: italic;
  }

  /* Offers section */
  .pricing-offers {
    background: var(--ink);
    color: var(--bg);
    padding: 120px 0;
  }

  .pricing-grid {
    display: flex;
    justify-content: center;
  }

  .pricing-card {
    background: var(--bg);
    color: var(--ink);
    max-width: 640px;
    width: 100%;
  }
  .pricing-card.featured {
    border: 2px solid var(--pink);
  }
  .pricing-inner {
    padding: 56px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .card-eyebrow {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .card-eyebrow .pip {
    width: 8px;
    height: 8px;
    background: var(--pink);
    display: inline-block;
  }

  .pricing-card h2 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(36px, 4vw, 48px);
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin: 0;
    max-width: 18ch;
    color: var(--ink);
  }
  .pricing-card h2 :global(em) {
    font-style: italic;
  }

  .price-lede {
    font-family: var(--serif);
    font-style: italic;
    color: var(--ink-soft);
    font-size: 17px;
    line-height: 1.45;
    margin: 0;
    max-width: 40ch;
  }
  .price-spacer {
    flex: 1;
    min-height: 8px;
  }

  .price-row {
    display: flex;
    align-items: baseline;
    gap: 16px;
  }
  .price {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(60px, 7.5vw, 96px);
    line-height: 0.85;
    letter-spacing: -0.04em;
    font-style: italic;
    background: var(--yellow);
    padding: 0 0.14em 0.04em;
    display: inline-block;
    color: var(--ink);
  }
  .delivery-badge {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--pink);
    font-weight: 500;
    display: block;
  }
  .frame-note {
    font-family: var(--serif);
    font-size: 17px;
    line-height: 1.45;
    color: var(--ink);
    margin: 0;
    max-width: 44ch;
  }

  .included h3 {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    font-weight: 500;
    margin: 0 0 16px;
  }
  .included ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    counter-reset: price-item;
  }
  .included li {
    font-family: var(--serif);
    font-size: 16px;
    line-height: 1.45;
    display: grid;
    grid-template-columns: 36px 1fr;
    align-items: baseline;
    padding: 10px 0;
    border-bottom: 1px solid var(--rule);
  }
  .included li:last-child {
    border-bottom: none;
  }
  .included li::before {
    counter-increment: price-item;
    content: counter(price-item, decimal-leading-zero);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--ink-soft);
    font-weight: 500;
  }

  .trade-note {
    font-family: var(--serif);
    font-style: italic;
    color: var(--ink-soft);
    font-size: 15px;
    line-height: 1.45;
    margin: 0;
  }

  .pricing-inner :global(.btn) {
    align-self: flex-start;
    margin-top: 8px;
  }

  .bottom-note {
    margin-top: 64px;
    font-family: var(--serif);
    font-size: 17px;
    color: #cfcabd;
    text-align: center;
  }
  .bottom-note a {
    color: var(--bg);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .bottom-note a:hover {
    color: var(--pink);
  }

  /* Cost comparison */
  .cost-compare {
    background: var(--bg);
    padding: 120px 0;
    border-bottom: 1px solid var(--rule);
  }
  .cost-compare h2 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(30px, 4vw, 44px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 40px;
    max-width: 20ch;
  }
  .table-wrap {
    position: relative;
  }
  .table-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .cost-compare table {
    width: 100%;
    border-collapse: collapse;
    min-width: 560px;
  }
  .table-hint {
    display: none;
  }
  @media (max-width: 700px) {
    /* The table scrolls horizontally past this width — signal it, since a plain
       overflow:auto container gives no visual cue that content continues offscreen. */
    .table-wrap::after {
      content: '';
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      width: 32px;
      background: linear-gradient(to right, transparent, var(--bg) 80%);
      pointer-events: none;
    }
    .table-hint {
      display: block;
      margin: 10px 0 0;
      font-family: var(--mono);
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--ink-soft);
    }
  }
  .cost-compare thead {
    border-bottom: 2px solid var(--ink);
  }
  .cost-compare th[scope='col'] {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--ink-soft);
    text-align: left;
    padding: 0 20px 14px 0;
  }
  .cost-compare tbody th[scope='row'] {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 17px;
    text-align: left;
  }
  .cost-compare td,
  .cost-compare tbody th {
    padding: 18px 20px 18px 0;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
    font-size: 16px;
    line-height: 1.4;
    color: var(--ink);
  }
  .cost-compare tr.is-kit th,
  .cost-compare tr.is-kit td {
    background: var(--yellow);
    font-weight: 600;
  }
  .cost-compare tr.is-kit th[scope='row'] {
    font-weight: 700;
  }
  .table-note {
    margin: 32px 0 0;
    font-family: var(--serif);
    font-size: 17px;
    line-height: 1.5;
    color: var(--ink-soft);
    max-width: 60ch;
  }
  .table-note a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  /* FAQ */
  .pricing-faq {
    padding: 120px 0;
    background: var(--bg);
    border-bottom: 1px solid var(--rule);
  }
  .faq-head {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(30px, 4vw, 44px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
  }
  .faq-head :global(em) {
    font-style: italic;
  }
  .faq-lede {
    font-size: 19px;
    line-height: 1.45;
    max-width: 60ch;
    margin: 0 0 40px;
    color: var(--ink-soft);
  }
  .faq-list {
    border-top: 1px solid var(--ink);
  }
  details.q {
    border-bottom: 1px solid var(--rule);
    padding: 0;
  }
  details.q summary {
    list-style: none;
    padding: 28px 0;
    cursor: pointer;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 32px;
    font-family: var(--serif);
    font-weight: 500;
    font-size: 24px;
    line-height: 1.25;
    letter-spacing: -0.01em;
    transition: color 0.15s;
  }
  details.q summary::-webkit-details-marker {
    display: none;
  }
  details.q .marker {
    flex: 0 0 32px;
    text-align: right;
    font-family: var(--serif);
    font-weight: 400;
    font-size: 32px;
    line-height: 1;
    color: var(--ink);
    transition: transform 0.2s;
    font-style: italic;
  }
  details.q[open] .marker {
    transform: rotate(45deg);
  }
  details.q .a {
    padding: 0 0 32px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink);
    max-width: 72ch;
  }
  details.q .a p {
    margin: 0;
  }

  @media (max-width: 900px) {
    .pricing-inner {
      padding: 36px;
    }
    .price {
      font-size: clamp(52px, 12vw, 80px);
    }
  }
</style>
