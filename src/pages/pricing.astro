---
import Base from '../layouts/Base.astro';
import Pricing from '../components/sections/Pricing.astro';
import Faq from '../components/sections/Faq.astro';
import CloseCta from '../components/sections/CloseCta.astro';

const offerSchema = {
  '@type': 'ProfessionalService',
  '@id': 'https://bestcasestud.io/#service',
  name: 'B2B case study production',
  serviceType: 'B2B case study production',
  provider: { '@id': 'https://bestcasestud.io/#org' },
  areaServed: 'Worldwide',
  url: 'https://bestcasestud.io/pricing/',
  description:
    'Two productised offers for B2B case studies built to rank on Google, get cited by ChatGPT, and persuade the people who read them.',
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '5',
    bestRating: '5',
    reviewCount: '6',
  },
  offers: [
    {
      '@type': 'Offer',
      name: 'Optimise an existing case study',
      price: '750',
      priceCurrency: 'USD',
      url: 'https://bestcasestud.io/pricing/',
      availability: 'https://schema.org/InStock',
      category: 'Marketing services',
    },
    {
      '@type': 'Offer',
      name: 'Build a new case study from scratch',
      price: '2500',
      priceCurrency: 'USD',
      url: 'https://bestcasestud.io/pricing/',
      availability: 'https://schema.org/InStock',
      category: 'Marketing services',
    },
  ],
};
---

<Base
  title="Case study pricing · $750 and $2,500 · Best Case Studio"
  description="Two productised offers: optimise an existing case study ($750) or build one from scratch ($2,500). Both deliver the Citable Case Study format. 14 business days."
  schema={[offerSchema]}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Pricing', url: '/pricing/' },
  ]}
>
  <section class="pricing-intro">
    <div class="wrap">
      <p class="eyebrow mono">Pricing</p>
      <h1>
        Two ways to <em>work together</em>.
      </h1>
      <p class="lede">
        Both deliver the Citable Case Study format. Both priced per case study. Volume discounts on three or more.
      </p>
      <dl class="quickfacts">
        <div>
          <dt>Optimise</dt>
          <dd>$750 USD per case study</dd>
        </div>
        <div>
          <dt>Build</dt>
          <dd>$2,500 USD per case study</dd>
        </div>
        <div>
          <dt>Turnaround</dt>
          <dd>14 business days</dd>
        </div>
        <div>
          <dt>Who it's for</dt>
          <dd>B2B SaaS companies, any geography</dd>
        </div>
      </dl>
    </div>
  </section>

  <Pricing />
  <Faq />
  <CloseCta />
</Base>

<style>
  .pricing-intro {
    background: var(--bg);
    padding: 180px 0 80px;
    border-bottom: 1px solid var(--rule);
  }
  .eyebrow {
    color: var(--ink-soft);
    margin: 0 0 24px;
  }
  h1 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(48px, 6.5vw, 104px);
    line-height: 0.98;
    letter-spacing: -0.025em;
    margin: 0 0 28px;
    max-width: 18ch;
  }
  h1 em {
    font-style: italic;
  }
  .lede {
    font-size: 22px;
    line-height: 1.45;
    max-width: 64ch;
    margin: 0 0 56px;
  }
  .quickfacts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    border-top: 1px solid var(--ink);
    padding-top: 32px;
    margin: 0;
  }
  .quickfacts > div {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .quickfacts dt {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    font-weight: 500;
  }
  .quickfacts dd {
    margin: 0;
    font-family: var(--serif);
    font-size: 17px;
    line-height: 1.4;
  }
  @media (max-width: 800px) {
    .quickfacts {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 500px) {
    .quickfacts {
      grid-template-columns: 1fr;
    }
  }
</style>
