---
import Base from '../layouts/Base.astro';
import MobileCta from '../components/MobileCta.astro';
import Pricing from '../components/sections/Pricing.astro';
import CloseCta from '../components/sections/CloseCta.astro';
import { pricingConfig } from '../data/pricing.config';

const { written, video, monthly } = pricingConfig;

const comparison = [
  { option: 'DIY / AI tools', cost: '$0–$500', get: 'Written only, no interview', highlight: false },
  { option: 'Freelance writer', cost: '$1,000–$2,500', get: 'Written only', highlight: false },
  { option: 'Written specialist', cost: '$1,500–$3,000', get: 'Written, video as paid add-on', highlight: false },
  { option: 'Best Case Studio (written)', cost: written.price, get: 'Written case study, done for you', highlight: true },
  { option: 'Best Case Studio (video)', cost: video.price, get: 'Written, video and social, done for you', highlight: true },
  { option: 'Premium video production', cost: '$6,000+', get: 'Video, often annual commitment', highlight: false },
  { option: 'Full-service agency', cost: '$5,000–$15,000+', get: 'Video, long engagement', highlight: false },
];

/* Commercial-mechanics FAQ — distinct from the homepage's objection-handling set. Single source
 * of truth: the visible <details> and the FAQPage JSON-LD below are both built from this array,
 * so they always match verbatim. */
const faq = [
  {
    q: 'Can I buy just a written case study?',
    a: 'Yes. That is the entry product: one done-for-you written story, from the ask to your approval.',
  },
  {
    q: 'What do I get with the video case study?',
    a: `${video.whatYouGet}.`,
  },
  {
    q: 'Can I buy several at once?',
    a: `Yes, the monthly plan: ${monthly.storiesPerMonth} stories a month, either type, ${monthly.discountPercent}% off. ${monthly.rollover}`,
  },
  {
    q: 'How long does it take?',
    a: `${written.deliveryTime}, for either product. The clock starts when your customer's in the chair, so the only variable is how fast you make the intro.`,
  },
  {
    q: 'How many rounds of revisions?',
    a: 'One consolidated round from you, and if your customer wants changes after they review it, we make those too. Your customer\'s comfort matters more than our process. Nobody ends up published saying something they\'d rather they hadn\'t.',
  },
  {
    q: 'What are the payment terms?',
    a: 'Half up front to book the slot, half when your first drafts land. The second payment is triggered by our delivery, not your sign-off, so you\'re never paying for work you haven\'t seen, and we\'re never chasing you for feedback before we can invoice.',
  },
];

const offerSchema = {
  '@type': 'Service',
  '@id': 'https://bestcasestud.io/#service',
  name: 'Done-for-you B2B case studies',
  serviceType: 'B2B case study production',
  provider: { '@id': 'https://bestcasestud.io/#org' },
  areaServed: 'Worldwide',
  url: 'https://bestcasestud.io/pricing/',
  description: 'We find the customer, run the interview and write the story, so your team has an answer when a prospect asks "why them?".',
  offers: [
    {
      '@type': 'Offer',
      name: written.name,
      price: String(written.priceNumeric),
      priceCurrency: 'USD',
      url: 'https://bestcasestud.io/pricing/',
      availability: 'https://schema.org/InStock',
      category: 'Marketing services',
    },
    {
      '@type': 'Offer',
      name: video.name,
      price: String(video.priceNumeric),
      priceCurrency: 'USD',
      url: 'https://bestcasestud.io/pricing/',
      availability: 'https://schema.org/InStock',
      category: 'Marketing services',
    },
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'What you get',
    itemListElement: [
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: written.name, description: written.whatYouGet } },
      ...video.features.map((f) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: f } })),
    ],
  },
};

const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Base
  title="Pricing | Best Case Studio"
  description="Two done-for-you case study products: written from $2,500, written plus video from $5,000. See what's included and book a call."
  schema={[offerSchema, faqSchema]}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Pricing', url: '/pricing/' },
  ]}
>
  <section class="pricing-intro">
    <div class="wrap">
      <p class="eyebrow mono">Pricing</p>
      <h1>
        Done-for-you B2B case studies, from <em>{written.price}.</em>
      </h1>
      <MobileCta />
    </div>
  </section>

  <Pricing />

  <section class="cost-compare">
    <div class="wrap">
      <h2>What a B2B case study costs in 2026</h2>
      <div class="table-wrap">
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th scope="col">Option</th>
                <th scope="col">Typical cost</th>
                <th scope="col">What you get</th>
              </tr>
            </thead>
            <tbody>
              {comparison.map((row) => (
                <tr class:list={[row.highlight && 'is-kit']}>
                  <th scope="row">{row.option}</th>
                  <td>{row.cost}</td>
                  <td>{row.get}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
      <p class="table-hint" aria-hidden="true">Swipe to see all columns →</p>
      <p class="table-note">
        Want the detail behind these numbers? Read <a href="/blog/how-much-does-a-b2b-case-study-cost/">the full breakdown of what a B2B case study costs</a>.
      </p>
    </div>
  </section>

  <section id="faq" class="pricing-faq">
    <div class="wrap-tight">
      <h2 class="faq-head">Frequently asked <em>questions</em>.</h2>
      <p class="faq-lede">Everything you need to know before you book.</p>
      <div class="faq-list">
        {faq.map((item) => (
          <details class="q">
            <summary>
              <span>{item.q}</span>
              <span class="marker" aria-hidden="true">+</span>
            </summary>
            <div class="a">
              <p>{item.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CloseCta />
</Base>

<style>
  /* Intro */
  .pricing-intro {
    background: var(--bg);
    padding: 180px 0 80px;
    border-bottom: 1px solid var(--rule);
  }
  .eyebrow {
    color: var(--ink-soft);
    margin: 0 0 24px;
  }
  h1 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(44px, 6vw, 92px);
    line-height: 0.98;
    letter-spacing: -0.025em;
    margin: 0 0 28px;
    max-width: 22ch;
  }
  h1 em {
    font-style: italic;
  }

  /* Cost comparison */
  .cost-compare {
    background: var(--bg);
    padding: 120px 0;
    border-bottom: 1px solid var(--rule);
  }
  .cost-compare h2 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(30px, 4vw, 44px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 40px;
    max-width: 20ch;
  }
  .table-wrap {
    position: relative;
  }
  .table-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .cost-compare table {
    width: 100%;
    border-collapse: collapse;
    min-width: 560px;
  }
  .table-hint {
    display: none;
  }
  @media (max-width: 700px) {
    /* The table scrolls horizontally past this width — signal it, since a plain
       overflow:auto container gives no visual cue that content continues offscreen. */
    .table-wrap::after {
      content: '';
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      width: 32px;
      background: linear-gradient(to right, transparent, var(--bg) 80%);
      pointer-events: none;
    }
    .table-hint {
      display: block;
      margin: 10px 0 0;
      font-family: var(--mono);
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--ink-soft);
    }
  }
  .cost-compare thead {
    border-bottom: 2px solid var(--ink);
  }
  .cost-compare th[scope='col'] {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--ink-soft);
    text-align: left;
    padding: 0 20px 14px 0;
  }
  .cost-compare tbody th[scope='row'] {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 17px;
    text-align: left;
  }
  .cost-compare td,
  .cost-compare tbody th {
    padding: 18px 20px 18px 0;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
    font-size: 16px;
    line-height: 1.4;
    color: var(--ink);
  }
  .cost-compare tr.is-kit th,
  .cost-compare tr.is-kit td {
    background: var(--yellow);
    font-weight: 600;
  }
  .cost-compare tr.is-kit th[scope='row'] {
    font-weight: 700;
  }
  .table-note {
    margin: 32px 0 0;
    font-family: var(--serif);
    font-size: 17px;
    line-height: 1.5;
    color: var(--ink-soft);
    max-width: 60ch;
  }
  .table-note a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  /* FAQ */
  .pricing-faq {
    padding: 120px 0;
    background: var(--bg);
    border-bottom: 1px solid var(--rule);
  }
  .faq-head {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(30px, 4vw, 44px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
  }
  .faq-head :global(em) {
    font-style: italic;
  }
  .faq-lede {
    font-size: 19px;
    line-height: 1.45;
    max-width: 60ch;
    margin: 0 0 40px;
    color: var(--ink-soft);
  }
  .faq-list {
    border-top: 1px solid var(--ink);
  }
  details.q {
    border-bottom: 1px solid var(--rule);
    padding: 0;
  }
  details.q summary {
    list-style: none;
    padding: 28px 0;
    cursor: pointer;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 32px;
    font-family: var(--serif);
    font-weight: 500;
    font-size: 24px;
    line-height: 1.25;
    letter-spacing: -0.01em;
    transition: color 0.15s;
  }
  details.q summary::-webkit-details-marker {
    display: none;
  }
  details.q .marker {
    flex: 0 0 32px;
    text-align: right;
    font-family: var(--serif);
    font-weight: 400;
    font-size: 32px;
    line-height: 1;
    color: var(--ink);
    transition: transform 0.2s;
    font-style: italic;
  }
  details.q[open] .marker {
    transform: rotate(45deg);
  }
  details.q .a {
    padding: 0 0 32px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink);
    max-width: 72ch;
  }
  details.q .a p {
    margin: 0;
  }
</style>
