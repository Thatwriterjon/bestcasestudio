---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Faq from '../components/sections/Faq.astro';
import CloseCta from '../components/sections/CloseCta.astro';

const included = [
  'Video case study — the full story, on camera, in your customer\'s own words',
  'Written case study — built to rank on Google and get cited by AI',
  'Video testimonial — a short, sharp cut for your homepage and socials',
  'Written testimonial — a pull-quote for your site, deck, and emails',
  'Social pack — LinkedIn carousel and short clips',
  'A "how to use it" guide — where each piece does the most damage',
];

const offerSchema = {
  '@type': 'ProfessionalService',
  '@id': 'https://bestcasestud.io/#service',
  name: 'The Proof Kit',
  serviceType: 'B2B case study production',
  provider: { '@id': 'https://bestcasestud.io/#org' },
  areaServed: 'Worldwide',
  url: 'https://bestcasestud.io/pricing/',
  description:
    'One recorded customer conversation becomes a complete B2B case study — video, written, testimonials, and a social pack. $2,500, delivered 14 days from the interview.',
  offers: [
    {
      '@type': 'Offer',
      name: 'The Proof Kit',
      price: '2500',
      priceCurrency: 'USD',
      url: 'https://bestcasestud.io/pricing/',
      availability: 'https://schema.org/InStock',
      category: 'Marketing services',
    },
  ],
};
---

<Base
  title="Pricing · The Proof Kit, $2,500 · Best Case Studio"
  description="One package, one price: $2,500 for a complete B2B case study — video, written, testimonials, and a social pack, delivered 14 days from the interview."
  schema={[offerSchema]}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Pricing', url: '/pricing/' },
  ]}
>
  <section class="pricing-intro">
    <div class="wrap">
      <p class="eyebrow mono">Pricing</p>
      <h1>
        One package. <em>One price.</em>
      </h1>
    </div>
  </section>

  <section class="pricing-offers">
    <div class="wrap">
      <div class="pricing-grid">
        <div class="pricing-card featured">
          <div class="pricing-inner">
            <span class="card-eyebrow"><span class="pip" aria-hidden="true"></span>The Proof Kit</span>
            <h2>Everything above. <em>One price.</em></h2>
            <p class="price-lede">One recorded conversation with your best customer, delivered as a complete proof set.</p>
            <div class="price-spacer"></div>
            <div class="price-row">
              <span class="price">$2,500</span>
            </div>
            <span class="founding-badge">Delivered 14 days from the interview</span>
            <div class="included">
              <h3>What's included</h3>
              <ul>
                {included.map((item: string) => (
                  <li><span>{item}</span></li>
                ))}
              </ul>
            </div>
            <p class="trade-note">Buy proof anywhere else in pieces and you'll spend $7,000–$10,000 before you've got a fraction of this. We productised the whole thing so you don't have to.</p>
            <Button href="/contact/" variant="primary">Book a call</Button>
          </div>
        </div>
      </div>

      <p class="bottom-note">
        Questions? <a href="/contact/">Get in touch</a>.
      </p>
    </div>
  </section>

  <Faq />
  <CloseCta />
</Base>

<style>
  /* Intro */
  .pricing-intro {
    background: var(--bg);
    padding: 180px 0 80px;
    border-bottom: 1px solid var(--rule);
  }
  .eyebrow {
    color: var(--ink-soft);
    margin: 0 0 24px;
  }
  h1 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(48px, 6.5vw, 104px);
    line-height: 0.98;
    letter-spacing: -0.025em;
    margin: 0 0 28px;
    max-width: 18ch;
  }
  h1 em {
    font-style: italic;
  }

  /* Offers section */
  .pricing-offers {
    background: var(--ink);
    color: var(--bg);
    padding: 120px 0;
  }

  .pricing-grid {
    display: flex;
    justify-content: center;
  }

  .pricing-card {
    background: var(--bg);
    color: var(--ink);
    max-width: 640px;
    width: 100%;
  }
  .pricing-card.featured {
    border: 2px solid var(--pink);
  }
  .pricing-inner {
    padding: 56px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .card-eyebrow {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .card-eyebrow .pip {
    width: 8px;
    height: 8px;
    background: var(--pink);
    display: inline-block;
  }

  .pricing-card h2 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(36px, 4vw, 48px);
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin: 0;
    max-width: 18ch;
    color: var(--ink);
  }
  .pricing-card h2 :global(em) {
    font-style: italic;
  }

  .price-lede {
    font-family: var(--serif);
    font-style: italic;
    color: var(--ink-soft);
    font-size: 17px;
    line-height: 1.45;
    margin: 0;
    max-width: 40ch;
  }
  .price-spacer {
    flex: 1;
    min-height: 8px;
  }

  .price-row {
    display: flex;
    align-items: baseline;
    gap: 16px;
  }
  .price {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(60px, 7.5vw, 96px);
    line-height: 0.85;
    letter-spacing: -0.04em;
    font-style: italic;
    background: var(--yellow);
    padding: 0 0.14em 0.04em;
    display: inline-block;
    color: var(--ink);
  }
  .founding-badge {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--pink);
    font-weight: 500;
    display: block;
  }

  .included h3 {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    font-weight: 500;
    margin: 0 0 16px;
  }
  .included ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    counter-reset: price-item;
  }
  .included li {
    font-family: var(--serif);
    font-size: 16px;
    line-height: 1.45;
    display: grid;
    grid-template-columns: 36px 1fr;
    align-items: baseline;
    padding: 10px 0;
    border-bottom: 1px solid var(--rule);
  }
  .included li:last-child {
    border-bottom: none;
  }
  .included li::before {
    counter-increment: price-item;
    content: counter(price-item, decimal-leading-zero);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--ink-soft);
    font-weight: 500;
  }

  .trade-note {
    font-family: var(--serif);
    font-style: italic;
    color: var(--ink-soft);
    font-size: 15px;
    line-height: 1.45;
    margin: 0;
  }

  .pricing-inner :global(.btn) {
    align-self: flex-start;
    margin-top: 8px;
  }

  .bottom-note {
    margin-top: 64px;
    font-family: var(--serif);
    font-size: 17px;
    color: #cfcabd;
    text-align: center;
  }
  .bottom-note a {
    color: var(--bg);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .bottom-note a:hover {
    color: var(--pink);
  }

  @media (max-width: 900px) {
    .pricing-inner {
      padding: 36px;
    }
    .price {
      font-size: clamp(52px, 12vw, 80px);
    }
  }
</style>
