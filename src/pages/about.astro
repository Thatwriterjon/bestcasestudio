---
import Base from '../layouts/Base.astro';
import AboutSection from '../components/sections/About.astro';
import CloseCta from '../components/sections/CloseCta.astro';

const aboutSchema = [
  {
    '@type': 'AboutPage',
    '@id': 'https://bestcasestud.io/about/#page',
    url: 'https://bestcasestud.io/about/',
    name: 'About Best Case Studio',
    isPartOf: { '@id': 'https://bestcasestud.io/#website' },
    about: { '@id': 'https://bestcasestud.io/#org' },
    mainEntity: { '@id': 'https://bestcasestud.io/#org' },
  },
  {
    '@type': 'Person',
    '@id': 'https://bestcasestud.io/#jon',
    name: 'Jon McGreevy',
    jobTitle: 'Founder, Lead',
    description:
      'Leads every project end-to-end. Seven years working with B2B SaaS on positioning, content and conversion. Writes at jonmcgreevy.com about trust and credibility in B2B SaaS and hosts the SaaSy as F**k podcast.',
    image: 'https://bestcasestud.io/team/jon-portrait-1.png',
    worksFor: { '@id': 'https://bestcasestud.io/#org' },
    sameAs: [
      'https://jonmcgreevy.com',
      'https://www.linkedin.com/in/jonmcgreevy/',
      'https://jonmcgreevy.substack.com',
    ],
  },
  {
    '@type': 'Person',
    '@id': 'https://bestcasestud.io/#jessie',
    name: 'Jessie McGreevy',
    jobTitle: 'Operations',
    description:
      'Runs scheduling, logistics and delivery. Makes sure the customer interview happens, the deliverables ship on time, and nothing gets lost between camera and client.',
    image: 'https://bestcasestud.io/team/jessie.jpg',
    worksFor: { '@id': 'https://bestcasestud.io/#org' },
  },
];
---

<Base
  title="About · Two-person case study studio for B2B SaaS"
  description="A two-person studio producing customer case studies for B2B SaaS — story-led video, written page, social assets. No outsourcing, no AI-written copy."
  schema={aboutSchema}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'About', url: '/about/' },
  ]}
>
  <section class="about-head">
    <div class="wrap">
      <p class="eyebrow mono">About</p>
      <h1>
        A <em>two-person studio</em>. No outsourcing, no AI-generated content.
      </h1>
      <p class="lede">
        Best Case Studio is Jon McGreevy and Jessie McGreevy. We produce customer case studies — story-led video, written page, and social assets — for B2B SaaS companies. One product, one price, fourteen business days from the customer interview to first drafts.
      </p>
    </div>
  </section>

  <section class="principles">
    <div class="wrap">
      <h2>How we work.</h2>
      <ol class="principle-list">
        <li>
          <h3>The customer's story leads.</h3>
          <p>We're interviewing your customer, not selling your product. The case study has to be true from their seat first; the marketing job follows from that. If a customer can't say something out loud, it doesn't go in.</p>
        </li>
        <li>
          <h3>One product, fixed price.</h3>
          <p>$2,500 per case study, every time. No tiers, no upsells, no surprise change orders. You always know what the next case study costs.</p>
        </li>
        <li>
          <h3>One round of consolidated revisions.</h3>
          <p>After first drafts we collect every piece of feedback — yours and your customer's — in one consolidated round. That keeps timelines honest and feedback coherent.</p>
        </li>
        <li>
          <h3>No outsourcing.</h3>
          <p>Jon runs every interview, writes every word, edits every video. Jessie keeps the project on rails. The same two people you talk to on the discovery call are the two people who deliver the work.</p>
        </li>
        <li>
          <h3>No AI-generated content.</h3>
          <p>We use AI for things like transcription cleanup, but the writing and editing are ours. A customer telling their story deserves a human listening to it.</p>
        </li>
      </ol>
    </div>
  </section>

  <AboutSection showHead={true} />

  <section class="origin">
    <div class="wrap">
      <h2>How we got here.</h2>
      <p>
        Jon spent seven years as a freelance writer and consultant for B2B SaaS — positioning, landing pages, sales enablement, content. The case studies kept coming up. Sales teams couldn't get them produced. Marketing teams couldn't keep them on the roadmap. Agencies quoted five-figure deliverables for one case study and took a quarter to ship.
      </p>
      <p>
        So we cut a single productized service out of all that: one customer, one story, fixed scope, fixed price, two-week production. The kind of thing a founder can buy without a procurement cycle and trust will actually ship. <a href="/pricing/">See what's included at the $2,500 fixed price</a>, or browse <a href="/case-studies/">recent work</a>.
      </p>
      <p>
        Jon writes about trust and credibility in B2B SaaS at <a href="https://jonmcgreevy.com" target="_blank" rel="noopener noreferrer">jonmcgreevy.com</a>, on <a href="https://jonmcgreevy.substack.com" target="_blank" rel="noopener noreferrer">Substack</a>, and on the <em>SaaSy as F**k</em> podcast.
      </p>
    </div>
  </section>

  <CloseCta />
</Base>

<style>
  .about-head {
    background: var(--bg);
    padding: 180px 0 80px;
    border-bottom: 1px solid var(--rule);
  }
  .eyebrow {
    color: var(--ink-soft);
    margin: 0 0 24px;
  }
  h1 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(48px, 6.5vw, 104px);
    line-height: 0.98;
    letter-spacing: -0.025em;
    margin: 0 0 28px;
    max-width: 18ch;
  }
  h1 em {
    font-style: italic;
  }
  .lede {
    font-size: 22px;
    line-height: 1.45;
    max-width: 60ch;
    margin: 0;
  }

  .principles,
  .origin {
    background: var(--bg);
    padding: 96px 0;
    border-bottom: 1px solid var(--rule);
  }
  .principles h2,
  .origin h2 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(36px, 4.5vw, 64px);
    line-height: 1;
    letter-spacing: -0.02em;
    margin: 0 0 48px;
  }
  .principle-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--ink);
    counter-reset: principle;
  }
  .principle-list li {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 32px;
    padding: 32px 0;
    border-bottom: 1px solid var(--rule);
  }
  .principle-list li::before {
    counter-increment: principle;
    content: counter(principle, decimal-leading-zero);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--ink-soft);
    font-weight: 500;
    padding-top: 12px;
  }
  .principle-list h3 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 24px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: 0 0 12px;
  }
  .principle-list p {
    font-size: 17px;
    line-height: 1.55;
    margin: 0;
    max-width: 64ch;
  }
  .origin p {
    font-size: 19px;
    line-height: 1.55;
    margin: 0 0 20px;
    max-width: 70ch;
  }
  .origin p:last-child {
    margin-bottom: 0;
  }
  .origin a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .origin em {
    font-style: italic;
  }

  @media (max-width: 700px) {
    .principle-list li {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .principle-list li::before {
      padding-top: 0;
    }
  }
</style>
