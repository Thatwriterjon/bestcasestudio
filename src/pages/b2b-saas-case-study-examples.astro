          {faqs.map(({ q, a }) => (
            <details class="q">
              <summary>
                <span>{q}</span>
                <span class="marker" aria-hidden="true">+</span>
              </summary>
              <div class="a"><p>{a}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>

