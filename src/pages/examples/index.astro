---
import Base from '../../layouts/Base.astro';
import CaseStudyExample from '../../components/CaseStudyExample.astro';
import ExampleSwitcher from '../../components/ExampleSwitcher.astro';
import RestOfKit from '../../components/sections/RestOfKit.astro';
import { examples } from '../../data/examples';

// The strongest visible example (lowest `order`) is canonical at /examples/. Reorder via the
// `order` field in data/examples.ts to feature a different one first. Hidden examples are
// excluded from the switcher (and get no page of their own).
const ordered = [...examples].filter((e) => !e.hidden).sort((a, b) => a.order - b.order);
const ex = ordered[0];
---

<Base
  title={`Proof Kit example: ${ex.client} & ${ex.customer} · Best Case Studio`}
  description={ex.pageDescription}
  ogType="article"
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Examples', url: '/examples/' },
  ]}
>
  <section class="ex-switch">
    <div class="wrap-tight">
      <ExampleSwitcher items={ordered} active={ex.slug} />
      <CaseStudyExample example={ex} eager />
    </div>
  </section>

  <RestOfKit example={ex} />
</Base>

<style>
  .ex-switch {
    background: var(--bg);
    padding: 160px 0 72px;
  }

  @media (max-width: 900px) {
    .ex-switch {
      padding-top: 120px;
    }
  }
</style>
