---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import { examples, exampleHref } from '../../data/examples';

// /examples/ is the hub: it lists every VISIBLE example and links to its own canonical page at
// /examples/<slug>/. Reorder via the `order` field in data/examples.ts. Hidden examples are
// excluded (and get no page of their own).
const ordered = [...examples].filter((e) => !e.hidden).sort((a, b) => a.order - b.order);
---

<Base
  title="Proof Kit examples: real B2B case studies · Best Case Studio"
  description="Real Proof Kits we've produced for B2B clients — video and written case studies, testimonials, and social packs, all cut from a single customer interview."
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Examples', url: '/examples/' },
  ]}
>
  <section class="ex-index">
    <div class="wrap">
      <SectionHead title="Real <em>Proof Kit</em>s we've produced." />
      <p class="lede">
        Every kit below started as one recorded conversation with a real customer. Video case
        study, written case study, both testimonials, and a social pack — cut from that single
        interview. Open one to see the whole thing.
      </p>
      <div class="ex-grid">
        {ordered.map((ex) => (
          <a class="ex-card" href={exampleHref(ex)}>
            <span class="ex-client">{ex.client} × {ex.customer}</span>
            <h3>{ex.title}</h3>
            <div class="ex-metric">
              <span class="ex-metric-v">{ex.hero.value}</span>
              <span class="ex-metric-l">{ex.hero.label}</span>
            </div>
            <span class="ex-cta">Watch the video. Read the study. See the full kit. <span class="arr" aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .ex-index {
    background: var(--bg);
    padding: 160px 0 120px;
    border-bottom: 1px solid var(--rule);
  }
  .lede {
    font-size: 19px;
    line-height: 1.55;
    max-width: 68ch;
    margin: 0 0 56px;
    color: var(--ink-soft);
  }
  .ex-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }
  .ex-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    background: var(--bg-2);
    border: 1px solid var(--ink);
    border-radius: 12px;
    padding: 40px;
    text-decoration: none;
    color: var(--ink);
    transition: transform 0.15s, background 0.15s;
  }
  .ex-card:hover {
    transform: translateY(-3px);
    background: var(--pink);
  }
  .ex-client {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    font-weight: 500;
  }
  .ex-card:hover .ex-client {
    color: var(--ink);
  }
  .ex-card h3 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 27px;
    line-height: 1.15;
    letter-spacing: -0.015em;
    margin: 0;
  }
  .ex-metric {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: auto;
    padding-top: 8px;
  }
  .ex-metric-v {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 44px;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .ex-metric-l {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .ex-card:hover .ex-metric-l {
    color: var(--ink);
  }
  .ex-cta {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .ex-card:hover .ex-cta {
    color: var(--ink);
  }
  .ex-cta .arr {
    transition: transform 0.15s;
  }
  .ex-card:hover .ex-cta .arr {
    transform: translateX(4px);
  }
  @media (max-width: 760px) {
    .ex-index {
      padding-top: 120px;
    }
    .ex-grid {
      grid-template-columns: 1fr;
    }
    .ex-card {
      padding: 28px;
    }
  }
</style>
