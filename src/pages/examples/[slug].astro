---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import CaseStudyExample from '../../components/CaseStudyExample.astro';
import ExampleSwitcher from '../../components/ExampleSwitcher.astro';
import RestOfKit from '../../components/sections/RestOfKit.astro';
import { examples, type CaseStudyExample as CS } from '../../data/examples';

// Every VISIBLE example gets its own canonical page at /examples/<slug>/; /examples/ itself is
// the index/hub. Hidden examples get no page.
export const getStaticPaths = (() => {
  const ordered = [...examples].filter((e) => !e.hidden).sort((a, b) => a.order - b.order);
  return ordered.map((ex) => ({
    params: { slug: ex.slug },
    props: { ex },
  }));
}) satisfies GetStaticPaths;

interface Props {
  ex: CS;
}

const { ex } = Astro.props;
const ordered = [...examples].filter((e) => !e.hidden).sort((a, b) => a.order - b.order);
---

<Base
  title={`Proof Kit example: ${ex.client} & ${ex.customer} · Best Case Studio`}
  description={ex.pageDescription}
  ogType="article"
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Examples', url: '/examples/' },
    { name: ex.customer, url: `/examples/${ex.slug}/` },
  ]}
>
  <section class="ex-switch">
    <div class="wrap-tight">
      <ExampleSwitcher items={ordered} active={ex.slug} />
      <CaseStudyExample example={ex} eager />
    </div>
  </section>

  <RestOfKit example={ex} />
</Base>

<style>
  .ex-switch {
    background: var(--bg);
    padding: 160px 0 72px;
  }

  @media (max-width: 900px) {
    .ex-switch {
      padding-top: 120px;
    }
  }
</style>
