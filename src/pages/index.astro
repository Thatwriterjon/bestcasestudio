---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import LogoWall from '../components/sections/LogoWall.astro';
import WhyCaseStudies from '../components/sections/WhyCaseStudies.astro';
import Process from '../components/sections/Process.astro';
import Pricing from '../components/sections/Pricing.astro';
import Differentiation from '../components/sections/Differentiation.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import DiscoveryCta from '../components/sections/DiscoveryCta.astro';
import About from '../components/sections/About.astro';
import Faq from '../components/sections/Faq.astro';
import CloseCta from '../components/sections/CloseCta.astro';

const testimonials = (await getCollection('testimonials')).sort(
  (a, b) => a.data.order - b.data.order,
);

const stripHtml = (s: string) => s.replace(/<[^>]+>/g, '');

const reviews = testimonials.map((t) => ({
  '@type': 'Review',
  author: {
    '@type': 'Person',
    name: t.data.name,
    jobTitle: t.data.role,
    worksFor: { '@type': 'Organization', name: t.data.company },
  },
  reviewBody: stripHtml(t.data.quote),
  itemReviewed: { '@id': 'https://bestcasestud.io/#service' },
}));

const homepageSchema = [
  {
    '@type': 'WebSite',
    '@id': 'https://bestcasestud.io/#website',
    url: 'https://bestcasestud.io/',
    name: 'Best Case Studio',
    publisher: { '@id': 'https://bestcasestud.io/#org' },
    inLanguage: 'en',
  },
  {
    '@type': 'ProfessionalService',
    '@id': 'https://bestcasestud.io/#service',
    name: 'B2B case study production',
    serviceType: 'B2B case study production',
    provider: { '@id': 'https://bestcasestud.io/#org' },
    areaServed: 'Worldwide',
    url: 'https://bestcasestud.io/',
    description:
      'Productised case study services for B2B SaaS: Optimise an existing case study ($997) or Build a new case study from scratch ($2,997). Founding Customer pricing in effect.',
    offers: [
      {
        '@type': 'Offer',
        name: 'Optimise an existing case study',
        price: '997',
        priceCurrency: 'USD',
        url: 'https://bestcasestud.io/#pricing',
        availability: 'https://schema.org/InStock',
        category: 'Marketing services',
      },
      {
        '@type': 'Offer',
        name: 'Build a new case study from scratch',
        price: '2997',
        priceCurrency: 'USD',
        url: 'https://bestcasestud.io/#pricing',
        availability: 'https://schema.org/InStock',
        category: 'Marketing services',
      },
    ],
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: '5',
      bestRating: '5',
      reviewCount: String(reviews.length),
    },
    review: reviews,
  },
];
---

<Base
  title="Best Case Studio — B2B case studies that get cited, ranked, and read"
  description="B2B case studies built to rank on Google, get cited by ChatGPT, and persuade the people who read them. Two productised offers. Transparent pricing."
  transparentNav
  schema={homepageSchema}
>
  <Hero />
  <LogoWall />
  <WhyCaseStudies />
  <Process />
  <Pricing />
  <Differentiation />
  <Testimonials />
  <DiscoveryCta />
  <About />
  <Faq />
  <CloseCta />
</Base>
