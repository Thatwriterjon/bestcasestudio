---
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import LogoWall from '../components/sections/LogoWall.astro';
import WhyCaseStudies from '../components/sections/WhyCaseStudies.astro';
import Process from '../components/sections/Process.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import ProofExamples from '../components/sections/ProofExamples.astro';
import Pricing from '../components/sections/Pricing.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import About from '../components/sections/About.astro';
import Faq from '../components/sections/Faq.astro';
import CloseCta from '../components/sections/CloseCta.astro';

const homepageSchema = [
  {
    '@type': 'WebSite',
    '@id': 'https://bestcasestud.io/#website',
    url: 'https://bestcasestud.io/',
    name: 'Best Case Studio',
    publisher: { '@id': 'https://bestcasestud.io/#org' },
    inLanguage: 'en',
  },
  {
    '@type': 'ProfessionalService',
    '@id': 'https://bestcasestud.io/#service',
    name: 'The Proof Kit',
    serviceType: 'B2B case study production',
    provider: { '@id': 'https://bestcasestud.io/#org' },
    areaServed: 'Worldwide',
    url: 'https://bestcasestud.io/',
    description:
      'One recorded customer conversation becomes a complete B2B case study — video, written, testimonials, and a social pack. $2,500, delivered 14 days from the interview.',
    offers: [
      {
        '@type': 'Offer',
        name: 'The Proof Kit',
        price: '2500',
        priceCurrency: 'USD',
        url: 'https://bestcasestud.io/#pricing',
        availability: 'https://schema.org/InStock',
        category: 'Marketing services',
      },
    ],
  },
];
---

<Base
  title="Best Case Studio — The Proof Kit: a complete B2B case study, $2,500"
  description="One conversation with your best customer becomes a complete B2B case study — video, written, and ready for everywhere your buyers look. $2,500, delivered 14 days from the interview."
  transparentNav
  schema={homepageSchema}
>
  <Hero />
  <LogoWall />
  <WhyCaseStudies />
  <Process />
  <HowItWorks />
  <ProofExamples />
  <Pricing />
  <Testimonials />
  <About />
  <Faq />
  <CloseCta />
</Base>
