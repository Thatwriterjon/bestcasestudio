---
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import LogoWall from '../components/sections/LogoWall.astro';
import WhyCaseStudies from '../components/sections/WhyCaseStudies.astro';
import Agitate from '../components/sections/Agitate.astro';
import WhyItWorks from '../components/sections/WhyItWorks.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import ProofExamples from '../components/sections/ProofExamples.astro';
import Pricing from '../components/sections/Pricing.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import About from '../components/sections/About.astro';
import Faq from '../components/sections/Faq.astro';
import CloseCta from '../components/sections/CloseCta.astro';
import { pricingConfig } from '../data/pricing.config';

const homepageSchema = [
  {
    '@type': 'WebSite',
    '@id': 'https://bestcasestud.io/#website',
    url: 'https://bestcasestud.io/',
    name: 'Best Case Studio',
    publisher: { '@id': 'https://bestcasestud.io/#org' },
    inLanguage: 'en',
  },
  {
    '@type': 'Service',
    '@id': 'https://bestcasestud.io/#service',
    name: 'Done-for-you B2B case studies',
    serviceType: 'B2B case study production',
    provider: { '@id': 'https://bestcasestud.io/#org' },
    areaServed: 'Worldwide',
    url: 'https://bestcasestud.io/',
    description:
      'We find the customer, run the interview and write the story, so your team has an answer when a prospect asks "why them?".',
    offers: [
      {
        '@type': 'Offer',
        name: pricingConfig.written.name,
        price: String(pricingConfig.written.priceNumeric),
        priceCurrency: 'USD',
        url: 'https://bestcasestud.io/pricing/',
        availability: 'https://schema.org/InStock',
        category: 'Marketing services',
      },
      {
        '@type': 'Offer',
        name: pricingConfig.video.name,
        price: String(pricingConfig.video.priceNumeric),
        priceCurrency: 'USD',
        url: 'https://bestcasestud.io/pricing/',
        availability: 'https://schema.org/InStock',
        category: 'Marketing services',
      },
    ],
  },
];
---

<Base
  title="Done-for-you B2B case studies | Best Case Studio"
  description={`We find the customer, run the interview and write the story, so your team has an answer when a prospect asks "why them?".`}
  transparentNav
  schema={homepageSchema}
>
  <Hero />
  <LogoWall />
  <WhyCaseStudies />
  <Agitate />
  <WhyItWorks />
  <HowItWorks />
  <Pricing />
  <ProofExamples />
  <Testimonials />
  <About />
  <Faq />
  <CloseCta />
</Base>
