---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import PostArticle from '../../components/PostArticle.astro';
import { getCollection } from 'astro:content';

export const getStaticPaths = (async () => {
  // Only comparison ("X vs Y") posts live here.
  const posts = (await getCollection('blog')).filter((p) => p.data.comparison);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const isoDate = post.data.date.toISOString();

/* ---- JSON-LD: Article ---- */
const articleSchema: Record<string, unknown> = {
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  image: 'https://bestcasestud.io/og.jpg',
  author: {
    '@type': 'Person',
    '@id': 'https://bestcasestud.io/#jon',
    name: post.data.author,
    url: 'https://bestcasestud.io/about/',
  },
  publisher: { '@id': 'https://bestcasestud.io/#org' },
  datePublished: isoDate,
  dateModified: post.data.updated ? post.data.updated.toISOString() : isoDate,
  mainEntityOfPage: `https://bestcasestud.io/compare/${post.id}/`,
};

/* ---- JSON-LD: FAQPage (if frontmatter has faq items) ---- */
const faqSchema: Record<string, unknown> | null = post.data.faq?.length
  ? {
      '@type': 'FAQPage',
      mainEntity: post.data.faq.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    }
  : null;

const schemas = [articleSchema, ...(faqSchema ? [faqSchema] : [])];
---

<Base
  title={`${post.data.title} · Best Case Studio`}
  description={post.data.description}
  ogType="article"
  schema={schemas}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Compare', url: '/compare/' },
    { name: post.data.title, url: `/compare/${post.id}/` },
  ]}
>
  <PostArticle post={post} basePath="/compare" />
</Base>
