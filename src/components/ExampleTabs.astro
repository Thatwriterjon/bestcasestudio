---
import { typeLabel, type CaseStudyExample } from '../data/examples';

interface Props {
  /** Examples in display order. The first (order 0) is canonical at /examples/. */
  items: CaseStudyExample[];
  /** Slug of the example currently shown, used to mark the active tab. */
  active: string;
}

const { items, active } = Astro.props;

/** The strongest example (index 0) lives at /examples/; the rest at /examples/<slug>/. */
const hrefFor = (ex: CaseStudyExample, i: number) =>
  i === 0 ? '/examples/' : `/examples/${ex.slug}/`;
---

<div class="tablist-wrap">
  <nav class="tablist" aria-label="Case study examples">
    {items.map((ex, i) => (
      <a
        href={hrefFor(ex, i)}
        class:list={['tab', ex.slug === active && 'is-active']}
        aria-current={ex.slug === active ? 'page' : undefined}
      >
        <span class="tab-client">{ex.tabLabel}</span>
        <span class="tab-sub">{ex.customer} · {typeLabel(ex.type)}</span>
      </a>
    ))}
  </nav>
</div>

<script>
  const strip = document.querySelector('.tablist') as HTMLElement | null;
  const wrap = document.querySelector('.tablist-wrap') as HTMLElement | null;
  const active = document.querySelector('.tablist .tab.is-active') as HTMLElement | null;

  if (strip && wrap) {
    // Show a soft edge fade whenever there's more strip to scroll toward, signalling the
    // switcher is horizontally scrollable rather than clipping the last tab silently.
    const syncFades = () => {
      const max = strip.scrollWidth - strip.clientWidth;
      wrap.classList.toggle('can-scroll-left', strip.scrollLeft > 1);
      wrap.classList.toggle('can-scroll-right', strip.scrollLeft < max - 1);
    };

    // Bring the active tab into view on load so it's never hidden past the right edge.
    if (active && strip.scrollWidth > strip.clientWidth) {
      const offset = active.offsetLeft - (strip.clientWidth - active.clientWidth) / 2;
      strip.scrollTo({ left: Math.max(0, offset), behavior: 'auto' });
    }

    syncFades();
    strip.addEventListener('scroll', syncFades, { passive: true });
    window.addEventListener('resize', syncFades);
  }
</script>

<style>
  /* Sticky wrapper so the switcher stays reachable while reading a long study, and so the
     edge-fade affordances can sit above the scrolling strip. */
  .tablist-wrap {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--bg);
    border-bottom: 1px solid var(--rule);
    margin-bottom: 56px;
  }
  /* Soft fades signalling more tabs off either edge. Toggled by class from the script. */
  .tablist-wrap::before,
  .tablist-wrap::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 1px;
    width: 48px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s;
    z-index: 1;
  }
  .tablist-wrap::before {
    left: 0;
    background: linear-gradient(to right, var(--bg), rgba(246, 243, 236, 0));
  }
  .tablist-wrap::after {
    right: 0;
    background: linear-gradient(to left, var(--bg), rgba(246, 243, 236, 0));
  }
  .tablist-wrap.can-scroll-left::before,
  .tablist-wrap.can-scroll-right::after {
    opacity: 1;
  }
  .tablist {
    display: flex;
    gap: 8px;
    padding: 16px 0;
    overflow-x: auto;
    scrollbar-width: none;
    scroll-snap-type: x proximity;
  }
  .tablist::-webkit-scrollbar {
    display: none;
  }
  .tab {
    scroll-snap-align: start;
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 20px;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: transparent;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
  }
  .tab:hover {
    border-color: var(--ink-faint);
  }
  .tab.is-active {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }
  .tab-client {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 19px;
    line-height: 1;
  }
  .tab-sub {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
    white-space: nowrap;
  }
  .tab.is-active .tab-sub {
    color: var(--ink-faint);
  }
</style>
