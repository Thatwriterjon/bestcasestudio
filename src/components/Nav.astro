---
import Wordmark from './Wordmark.astro';

interface Props {
  /** When true, the nav starts transparent and is upgraded to the solid state once the user
   * scrolls past the first <section>. Used on the home page over the pink hero. */
  transparent?: boolean;
}

const { transparent = false } = Astro.props;
---

<header class:list={['nav', !transparent && 'scrolled', transparent && 'is-transparent']} id="nav">
  <div class="wrap nav-inner">
    <Wordmark href="/" />
    <nav aria-label="Primary">
      <ul>
        <li><a href="/pricing/">Pricing</a></li>
        <li><a href="/#methodology">Methodology</a></li>
        <li><a href="/#proof">Proof</a></li>
        <li><a href="/#faq">FAQ</a></li>
        <li><a href="/contact/" class="cta">Free audit →</a></li>
      </ul>
    </nav>
  </div>
</header>

{transparent && (
  <script>
    const nav = document.getElementById('nav');
    const sentinel = document.querySelector('main > section, main > .hero, .hero');
    if (nav && sentinel) {
      const io = new IntersectionObserver(
        ([entry]) => {
          // Once the hero scrolls mostly out of view, switch the nav to its solid state.
          if (entry.intersectionRatio < 0.15) nav.classList.add('scrolled');
          else nav.classList.remove('scrolled');
        },
        { threshold: [0, 0.15, 0.5, 1] }
      );
      io.observe(sentinel);
    }
  </script>
)}

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    padding: 20px 0;
    background: transparent;
    transition: background 0.25s, border-color 0.25s, padding 0.25s;
  }
  .nav.scrolled {
    background: var(--bg);
    border-bottom: 1px solid var(--rule);
    padding: 14px 0;
  }
  /* While the nav is still transparent over the pink hero, the wordmark's pink dot would
     vanish into the background. Swap it to yellow until the nav switches to its solid state. */
  .nav.is-transparent:not(.scrolled) {
    --wordmark-dot: var(--yellow);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  nav ul {
    list-style: none;
    display: flex;
    gap: 36px;
    padding: 0;
    margin: 0;
    align-items: center;
  }
  nav a {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 500;
  }
  nav a.cta {
    background: var(--ink);
    color: var(--bg);
    padding: 10px 16px;
    border-radius: 999px;
  }
  nav a.cta:hover {
    background: #000;
  }
  nav a:not(.cta):hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  @media (max-width: 820px) {
    nav ul {
      gap: 20px;
    }
    nav li:not(:last-child):not(:first-child) {
      display: none;
    }
    /* On narrow screens keep just Pricing + Free audit to avoid wrap. */
    nav li:first-child {
      display: list-item;
    }
  }
  @media (max-width: 540px) {
    nav li:not(.cta-li):not(:last-child) {
      display: none;
    }
    nav ul {
      gap: 12px;
    }
  }
</style>
