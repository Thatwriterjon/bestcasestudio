---
import Wordmark from './Wordmark.astro';

interface Props {
  /** When true, the nav starts transparent and is upgraded to the solid state once the user
   * scrolls past the first <section>. Used on the home page over the pink hero. */
  transparent?: boolean;
}

const { transparent = false } = Astro.props;
---

<header class:list={['nav', !transparent && 'scrolled', transparent && 'is-transparent']} id="nav">
  <div class="wrap nav-inner">
    <Wordmark href="/" />
    <nav aria-label="Primary">
      <ul class="desktop-links">
        <li><a href="/pricing/">Pricing</a></li>
        <li><a href="/#methodology">Methodology</a></li>
        <li><a href="/#proof">Proof</a></li>
        <li><a href="/#faq">FAQ</a></li>
        <li><a href="/contact/" class="cta">Free audit →</a></li>
      </ul>
      <button class="burger" id="burger" type="button" aria-label="Open menu" aria-expanded="false">
        <span class="burger-line"></span>
        <span class="burger-line"></span>
      </button>
    </nav>
  </div>
  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <ul>
      <li><a href="/pricing/">Pricing</a></li>
      <li><a href="/#methodology">Methodology</a></li>
      <li><a href="/#proof">Proof</a></li>
      <li><a href="/#faq">FAQ</a></li>
      <li><a href="/contact/">Contact</a></li>
      <li><a href="/contact/" class="cta">Free audit →</a></li>
    </ul>
  </div>
</header>

<script>
  const burger = document.getElementById('burger');
  const menu = document.getElementById('mobile-menu');
  const nav = document.getElementById('nav');
  if (burger && menu && nav) {
    burger.addEventListener('click', () => {
      const open = nav.classList.toggle('menu-open');
      burger.setAttribute('aria-expanded', String(open));
      menu.setAttribute('aria-hidden', String(!open));
    });
    // Close menu when a link is tapped
    menu.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => {
        nav.classList.remove('menu-open');
        burger.setAttribute('aria-expanded', 'false');
        menu.setAttribute('aria-hidden', 'true');
      });
    });
  }
</script>

{transparent && (
  <script>
    const nav = document.getElementById('nav');
    const sentinel = document.querySelector('main > section, main > .hero, .hero');
    if (nav && sentinel) {
      const io = new IntersectionObserver(
        ([entry]) => {
          // Once the hero scrolls mostly out of view, switch the nav to its solid state.
          if (entry.intersectionRatio < 0.15) nav.classList.add('scrolled');
          else nav.classList.remove('scrolled');
        },
        { threshold: [0, 0.15, 0.5, 1] }
      );
      io.observe(sentinel);
    }
  </script>
)}

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    padding: 20px 0;
    background: transparent;
    transition: background 0.25s, border-color 0.25s, padding 0.25s;
  }
  .nav.scrolled {
    background: var(--bg);
    border-bottom: 1px solid var(--rule);
    padding: 14px 0;
  }
  /* While the nav is still transparent over the pink hero, the wordmark's pink dot would
     vanish into the background. Swap it to yellow until the nav switches to its solid state. */
  .nav.is-transparent:not(.scrolled) {
    --wordmark-dot: var(--yellow);
  }
  /* When mobile menu is open, always show solid background */
  .nav.menu-open {
    background: var(--bg);
    border-bottom: 1px solid var(--rule);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .desktop-links {
    list-style: none;
    display: flex;
    gap: 36px;
    padding: 0;
    margin: 0;
    align-items: center;
  }
  nav a {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 500;
  }
  nav a.cta {
    background: var(--ink);
    color: var(--bg);
    padding: 10px 16px;
    border-radius: 999px;
  }
  nav a.cta:hover {
    background: #000;
  }
  nav a:not(.cta):hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* Hamburger button — hidden on desktop */
  .burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 48px;
    height: 48px;
    padding: 12px;
    cursor: pointer;
    background: none;
    border: none;
  }
  .burger-line {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--ink);
    transition: transform 0.2s, opacity 0.2s;
  }
  .menu-open .burger .burger-line:first-child {
    transform: translateY(4px) rotate(45deg);
  }
  .menu-open .burger .burger-line:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }

  /* Mobile menu panel */
  .mobile-menu {
    display: none;
    background: var(--bg);
    border-bottom: 1px solid var(--rule);
    padding: 0 48px 32px;
  }
  .mobile-menu ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .mobile-menu li {
    border-top: 1px solid var(--rule);
  }
  .mobile-menu a {
    display: block;
    font-family: var(--serif);
    font-size: 20px;
    font-weight: 500;
    padding: 16px 0;
    color: var(--ink);
  }
  .mobile-menu a.cta {
    display: inline-block;
    margin-top: 8px;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background: var(--ink);
    color: var(--bg);
    padding: 14px 24px;
    border-radius: 999px;
    border: none;
  }
  .mobile-menu li:last-child {
    border-top: none;
    padding-top: 8px;
  }

  @media (max-width: 820px) {
    .desktop-links {
      display: none;
    }
    .burger {
      display: flex;
    }
    .menu-open .mobile-menu {
      display: block;
    }
  }
  @media (max-width: 900px) {
    .mobile-menu {
      padding-left: 24px;
      padding-right: 24px;
    }
  }
</style>
