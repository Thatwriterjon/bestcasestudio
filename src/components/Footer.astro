---
import Wordmark from './Wordmark.astro';

const year = new Date().getFullYear();
---

<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div class="col brand">
        <Wordmark href="/" />
        <p>One conversation with your best customer becomes a complete Proof Kit — video, written, everywhere your buyers look. $2,500, delivered in 14 days.</p>
      </div>
      <div class="col">
        <h6>Site</h6>
        <ul>
          <li><a href="/pricing/">Pricing</a></li>
          <li><a href="/examples/">Examples</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/#whats-included">What you get</a></li>
          <li><a href="/#proof">Proof</a></li>
          <li><a href="/#faq">FAQ</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="mailto:jon@bestcasestud.io">Refer someone</a></li>
        </ul>
      </div>
      <div class="col">
        <h6>Compare</h6>
        <ul>
          <li><a href="/compare/">How we compare →</a></li>
          <li><a href="/compare/best-case-studio-vs-testimonial-hero/">vs Testimonial Hero</a></li>
          <li><a href="/compare/best-case-studio-vs-uplift-content/">vs Uplift Content</a></li>
          <li><a href="/compare/best-case-studio-vs-successkit/">vs SuccessKit</a></li>
          <li><a href="/compare/best-case-studio-vs-storyvoice/">vs StoryVoice</a></li>
          <li><a href="/compare/best-case-studio-vs-content-agencies/">vs content agencies</a></li>
          <li><a href="/compare/best-case-studio-vs-freelancers-and-chatgpt/">vs freelancers &amp; AI</a></li>
        </ul>
      </div>
      <div class="col">
        <h6>Elsewhere</h6>
        <ul>
          <li><a href="https://www.linkedin.com/in/thatwriterjon/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></li>
          <li><a href="https://jonmcgreevy.substack.com" target="_blank" rel="noopener noreferrer">Substack ↗</a></li>
          <li><a href="https://open.spotify.com/show/6mH42FJY0OA3CNiMAIj4cN" target="_blank" rel="noopener noreferrer">Spotify ↗</a></li>
          <li><a href="https://podcasts.apple.com/us/podcast/saasy-as-f-k-podcast/id1573388272" target="_blank" rel="noopener noreferrer">Apple Podcasts ↗</a></li>
        </ul>
      </div>
    </div>
    <div class="referral-note">
      <strong>Referrals:</strong> $500 cash per referral, no cap, paid when the client makes their first payment. <a href="mailto:jon@bestcasestud.io">Email us →</a>
    </div>
    <div class="foot-row">
      <span class="mono">© {year} Best Case Studio · All rights reserved.</span>
      <a class="mono privacy-link" href="/privacy/">Privacy</a>
    </div>
  </div>
</footer>

<style>
  footer {
    padding: 64px 0 48px;
    background: var(--bg);
  }
  .foot-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 40px;
    padding-bottom: 48px;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 24px;
  }
  .col h6 {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    font-weight: 500;
    margin: 0 0 18px;
  }
  .col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .col a {
    font-family: var(--serif);
    font-size: 17px;
    font-weight: 500;
  }
  .col a:hover {
    font-style: italic;
  }
  .col.brand p {
    margin: 14px 0 0;
    font-style: italic;
    color: var(--ink-soft);
    font-size: 16px;
    max-width: 34ch;
    line-height: 1.5;
  }
  .referral-note {
    font-family: var(--serif);
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-soft);
    padding-bottom: 24px;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 24px;
  }
  .referral-note strong {
    font-weight: 600;
    color: var(--ink);
  }
  .referral-note a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .foot-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
  }
  .foot-row .mono {
    color: var(--ink-soft);
  }
  @media (max-width: 820px) {
    .foot-grid {
      grid-template-columns: 1fr 1fr;
    }
    .foot-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  }
  @media (max-width: 500px) {
    .foot-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
