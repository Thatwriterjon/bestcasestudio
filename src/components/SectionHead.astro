---
interface Props {
  /** HTML allowed — use <em> for italics. */
  title: string;
  /** Right-aligned mono number, e.g. "§ 01 / The case". */
  num?: string;
  /** Tighter bottom margin variant. */
  compact?: boolean;
  /** Heading level to render. Defaults to h2 (the component's normal use as a sub-section
   *  header under a page's own h1). Pass 'h1' on pages where this is the only heading. */
  level?: 'h1' | 'h2';
}

const { title, num, compact = false, level = 'h2' } = Astro.props;
const Tag = level;
---

<div class:list={['sec-head', compact && 'compact']}>
  <Tag set:html={title} />
  {num && <span class="sec-num">{num}</span>}
</div>

<style>
  .sec-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 64px;
    gap: 32px;
  }
  .sec-head.compact {
    margin-bottom: 48px;
  }
  .sec-head h2 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(40px, 5vw, 72px);
    line-height: 1;
    letter-spacing: -0.02em;
    margin: 0;
    max-width: 20ch;
  }
  .sec-head h2 :global(em) {
    font-style: italic;
  }
  .sec-num {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    white-space: nowrap;
  }
  @media (max-width: 700px) {
    .sec-head {
      flex-direction: column;
      gap: 12px;
    }
  }
</style>
