---
import { Image } from 'astro:assets';
import SectionHead from '../SectionHead.astro';
import jonPhoto from '../../assets/team/jon-portrait-1.jpg';
import jessiePhoto from '../../assets/team/jessie.jpg';

interface Props {
  /** Show the section header. Disabled when used inside a dedicated /about page that has its own header. */
  showHead?: boolean;
}

const { showHead = true } = Astro.props;
---

<section id="about">
  <div class="wrap">
    {showHead && <SectionHead title="Who's actually <em>doing this</em>." />}
    <p class="lede">Best Case Studio is a two-person, husband and wife studio. We might sometimes use freelancers for content creation, but every interview is carried out by Jon.</p>
    <div class="about-rows">
      <div class="person-row">
        <div class="portrait">
          <Image src={jonPhoto} alt="Jon McGreevy" loading="lazy" width={240} height={300} format="webp" />
        </div>
        <div>
          <span class="who-name">Jon McGreevy</span>
          <h3>Strategy, interviews, content lead.</h3>
          <span class="role-tag">Founder · Content</span>
        </div>
        <div>
          <p class="bio">
            Leads every project end to end, using his eight years experience working with B2B companies on positioning, content, and conversion. Co-host of the <em>SaaSy as F**k</em> podcast.
          </p>
        </div>
      </div>
      <div class="person-row jess">
        <div class="portrait">
          <Image src={jessiePhoto} alt="Jessie McGreevy" loading="lazy" width={240} height={300} format="webp" />
        </div>
        <div>
          <span class="who-name">Jessie McGreevy</span>
          <h3>Keeps projects <em>on track</em>.</h3>
          <span class="role-tag">Founder · Operations</span>
        </div>
        <div>
          <p class="bio">
            Scheduling, logistics, the bit where someone has to make sure the customer interview actually happens on the day, the deliverables ship on time, and nothing gets lost between the camera and the client.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  section {
    padding: 120px 0;
    background: var(--yellow);
    border-bottom: 1px solid var(--ink);
  }
  .lede {
    font-size: 21px;
    line-height: 1.45;
    max-width: 64ch;
    margin: 0 0 56px;
    color: var(--ink);
  }
  .about-rows {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--ink);
  }
  .person-row {
    display: grid;
    grid-template-columns: 280px 1fr 1fr;
    gap: 64px;
    padding: 64px 0;
    border-bottom: 1px solid rgba(28, 27, 24, 0.25);
    align-items: start;
  }
  .person-row:last-child {
    border-bottom: 1px solid var(--ink);
  }
  .portrait {
    width: 240px;
    height: 300px;
    background: var(--ink);
    position: relative;
    overflow: hidden;
  }
  .person-row.jess .portrait {
    background: var(--pink);
  }
  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .who-name {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    font-weight: 500;
    margin-bottom: 18px;
    display: block;
  }
  h3 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 40px;
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin: 0 0 18px;
    max-width: 14ch;
  }
  h3 :global(em) {
    font-style: italic;
  }
  .role-tag {
    display: inline-block;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
    font-weight: 500;
    padding: 6px 10px;
    border: 1px solid var(--ink);
    margin-top: 8px;
  }
  .bio {
    font-size: 18px;
    line-height: 1.55;
    margin: 0 0 16px;
    color: var(--ink);
    max-width: 42ch;
  }
  .bio em {
    font-style: italic;
  }
  .bio a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 900px) {
    .person-row {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 48px 0;
    }
    .portrait {
      width: 100%;
      max-width: 320px;
      height: 360px;
    }
  }
</style>
