---
import Button from '../Button.astro';

interface Row {
  k: string;
  /** HTML-allowed value. */
  v: string;
}

const rows: Row[] = [
  { k: 'Duration', v: '30 minutes' },
  { k: 'Format', v: 'Remote · video call' },
  { k: 'Cost', v: '<em>Free</em>' },
  { k: 'Pitch level', v: 'Zero' },
  { k: 'Output', v: 'An honest answer' },
];
---

<section class="discovery" aria-label="Book a discovery call">
  <div class="wrap inner">
    <div>
      <h2>Let's make <span class="yelhl">things happen</span>.</h2>
      <p>
        Book a free 30-minute discovery call. No hard sell, just a conversation about whether case studies are the right move for you right now.
      </p>
      <div class="ctas">
        <Button href="/contact" variant="primary">Book a discovery call</Button>
      </div>
    </div>
    <dl class="right">
      {rows.map((r) => (
        <div class="row">
          <dt>{r.k}</dt>
          <dd class="v" set:html={r.v} />
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .discovery {
    background: var(--bg);
    color: var(--ink);
    padding: 120px 0;
    border-bottom: 1px solid var(--rule);
  }
  .inner {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 64px;
    align-items: center;
  }
  .discovery h2 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(44px, 5.5vw, 84px);
    line-height: 1;
    letter-spacing: -0.02em;
    margin: 0 0 24px;
    color: var(--ink);
  }
  .yelhl {
    background: var(--yellow);
    color: var(--ink);
    padding: 0 0.12em 0.04em;
    display: inline-block;
  }
  .discovery p {
    font-size: 19px;
    line-height: 1.55;
    color: var(--ink-soft);
    margin: 0 0 32px;
    max-width: 48ch;
  }
  .right {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0;
  }
  .row {
    display: flex;
    justify-content: space-between;
    border-top: 1px solid var(--rule);
    padding-top: 12px;
    gap: 24px;
  }
  .row dt {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    font-weight: 500;
  }
  .row .v {
    color: var(--ink);
    font-family: var(--serif);
    font-size: 16px;
    letter-spacing: -0.005em;
    font-weight: 500;
    margin: 0;
  }
  .row .v :global(em) {
    font-style: italic;
    color: var(--pink);
  }
  @media (max-width: 900px) {
    .inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
