---
import Button from '../Button.astro';
---

<section id="audit" class="audit" aria-label="Free audit">
  <div class="wrap">
    <div>
      <h2>Send us your <span class="yelhl">worst-performing</span> case study.</h2>
      <p>
        We'll audit it against the Citable Case Study format and tell you exactly what's broken. Free, written, no call required.
      </p>
      <p>
        If the gaps are worth fixing, the next step is clear. If not, you'll have a definitive answer.
      </p>
      <div class="ctas">
        <Button href="mailto:jon@bestcasestud.io" variant="primary">Email us your case study</Button>
      </div>
      <p class="secondary">
        Send a public URL or a PDF. We'll respond within five business days with a written audit. No call required, no sales follow-up.
      </p>
    </div>
  </div>
</section>

<style>
  .audit {
    background: var(--bg);
    color: var(--ink);
    padding: 120px 0;
    border-bottom: 1px solid var(--rule);
  }
  .audit h2 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(44px, 5.5vw, 84px);
    line-height: 1;
    letter-spacing: -0.02em;
    margin: 0 0 32px;
    color: var(--ink);
    max-width: 18ch;
  }
  .yelhl {
    background: var(--yellow);
    color: var(--ink);
    padding: 0 0.12em 0.04em;
    display: inline-block;
  }
  .audit p {
    font-size: 19px;
    line-height: 1.55;
    color: var(--ink);
    margin: 0 0 20px;
    max-width: 56ch;
  }
  .ctas {
    margin-top: 12px;
    margin-bottom: 24px;
  }
  .secondary {
    font-size: 16px;
    color: var(--ink-soft);
    font-style: italic;
    margin: 0;
  }
</style>
