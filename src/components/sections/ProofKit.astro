---
/**
 * 2A — "Your Proof Kit." section.
 * A show-don't-tell viewer that drops into the home page (replacing the old Process list).
 * A KIT switcher flips between real example kits; a file rail selects which of the six
 * assets shows in the panel. No CTA (intentionally — the section links out via the
 * written-case "Read the full case study →" button only).
 *
 * Interactivity is a tiny vanilla island: it toggles the visibility of pre-rendered
 * viewers (per kit) and slots (per file). No framework.
 */
import { examples, kitAssets, exampleHref } from '../../data/examples';
import KitAssetPreview from '../KitAssetPreview.astro';

// Feature the two published "built from scratch" kits, strongest first.
const featured = [...examples]
  .filter((e) => !e.hidden)
  .sort((a, b) => a.order - b.order)
  .slice(0, 2);

const DEFAULT_FILE = 'video-case';
---

<section id="whats-included" class="pk">
  <div class="wrap-tight">
    <div class="pk-intro">
      <p class="pk-eyebrow">YOUR PROOF KIT</p>
      <h2 class="pk-title">Your <em>Proof Kit.</em></h2>
      <p class="pk-lede">
        You just make the introduction, and we take care of the rest. We record an interview with
        your client, and from that conversation we build you a treasure chest of trust-building
        assets.
      </p>
    </div>

    <div class="pk-switch">
      <span class="pk-switch-label">KIT</span>
      {featured.map((ex, i) => (
        <button
          type="button"
          class:list={['pk-pill', i === 0 && 'is-active']}
          data-kit-btn={ex.slug}
          aria-pressed={i === 0 ? 'true' : 'false'}
        >
          {ex.client} <span class="pk-pill-cust">· {ex.customer}</span>
        </button>
      ))}
    </div>

    <div class="pk-viewers">
      {featured.map((ex, i) => (
        <div class="pk-viewer" data-kit={ex.slug} hidden={i !== 0}>
          <div class="pk-rail" role="tablist" aria-label={`${ex.client} Proof Kit files`}>
            <div class="pk-rail-head">
              <span class="pk-folder" aria-hidden="true"></span>
              <span class="pk-rail-name">{ex.client} — Proof Kit</span>
              <span class="pk-rail-count">6 files</span>
            </div>
            {kitAssets.map((a) => (
              <button
                type="button"
                role="tab"
                class:list={['pk-file', a.key === DEFAULT_FILE && 'is-active']}
                data-file={a.key}
                aria-selected={a.key === DEFAULT_FILE ? 'true' : 'false'}
              >
                <span class="pk-file-n">{a.n}</span>
                <span class="pk-file-txt">
                  <span class="pk-file-title">{a.title}</span>
                  <span class="pk-file-tag">{a.tag}</span>
                </span>
              </button>
            ))}
          </div>

          <div class="pk-panel">
            {kitAssets.map((a) => (
              <div class="pk-slot" data-slot={a.key} hidden={a.key !== DEFAULT_FILE}>
                <div class="pk-slot-meta">{a.n} / 06 · {a.tag}</div>
                <h3 class="pk-slot-title">{a.title}</h3>
                <p class="pk-slot-desc">{a.desc}</p>
                <KitAssetPreview
                  assetKey={a.key}
                  example={ex}
                  articleHref={exampleHref(ex)}
                  eager={i === 0 && a.key === DEFAULT_FILE}
                />
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.pk').forEach((section) => {
    // ---- Kit switch (which example viewer is shown) ----
    const kitBtns = section.querySelectorAll<HTMLButtonElement>('[data-kit-btn]');
    const viewers = section.querySelectorAll<HTMLElement>('[data-kit]');
    kitBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const slug = btn.dataset.kitBtn;
        kitBtns.forEach((b) => {
          const on = b === btn;
          b.classList.toggle('is-active', on);
          b.setAttribute('aria-pressed', String(on));
        });
        viewers.forEach((v) => {
          v.hidden = v.dataset.kit !== slug;
        });
      });
    });

    // ---- File switch (which asset slot is shown, per viewer) ----
    section.querySelectorAll<HTMLElement>('[data-kit]').forEach((viewer) => {
      const files = viewer.querySelectorAll<HTMLButtonElement>('[data-file]');
      const slots = viewer.querySelectorAll<HTMLElement>('[data-slot]');
      files.forEach((file) => {
        file.addEventListener('click', () => {
          const key = file.dataset.file;
          files.forEach((f) => {
            const on = f === file;
            f.classList.toggle('is-active', on);
            f.setAttribute('aria-selected', String(on));
          });
          slots.forEach((s) => {
            s.hidden = s.dataset.slot !== key;
          });
        });
      });
    });
  });
</script>

<style>
  .pk {
    padding: 120px 0;
    background: var(--bg);
    border-bottom: 1px solid var(--rule);
  }
  .pk-intro {
    max-width: 760px;
  }
  .pk-eyebrow {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    color: var(--pk-accent);
    margin: 0;
  }
  .pk-title {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(30px, 4vw, 38px);
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin: 14px 0 0;
  }
  .pk-title :global(em) {
    font-style: italic;
    color: var(--pk-accent);
  }
  .pk-lede {
    font-size: 16px;
    line-height: 1.65;
    color: var(--pk-muted);
    margin: 16px 0 0;
  }

  /* ---- KIT switcher ---- */
  .pk-switch {
    margin-top: 28px;
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .pk-switch-label {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.13em;
    color: var(--pk-faint);
  }
  .pk-pill {
    font-size: 13.5px;
    font-weight: 600;
    padding: 7px 14px;
    border-radius: 999px;
    border: 1px solid var(--pk-line-strong);
    background: var(--pk-surface);
    color: var(--pk-ink);
    transition: background 0.15s, border-color 0.15s, color 0.15s;
  }
  .pk-pill-cust {
    font-weight: 400;
    opacity: 0.6;
  }
  .pk-pill.is-active {
    background: var(--pk-ink);
    color: var(--pk-surface);
    border-color: var(--pk-ink);
  }

  /* ---- Viewer ---- */
  .pk-viewers {
    margin-top: 24px;
  }
  .pk-viewer {
    border: 1px solid var(--pk-line);
    border-radius: 16px;
    overflow: hidden;
    display: grid;
    grid-template-columns: 320px 1fr;
    background: var(--pk-surface);
  }
  .pk-viewer[hidden] {
    display: none;
  }

  /* Left rail */
  .pk-rail {
    border-right: 1px solid var(--pk-line);
    background: var(--pk-surface-2);
  }
  .pk-rail-head {
    padding: 16px 18px;
    border-bottom: 1px solid var(--pk-line);
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .pk-folder {
    width: 16px;
    height: 13px;
    border: 1.5px solid var(--pk-accent);
    border-radius: 2px;
    flex: none;
  }
  .pk-rail-name {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--pk-muted);
  }
  .pk-rail-count {
    margin-left: auto;
    font-family: var(--mono);
    font-size: 11px;
    color: #b8ae97;
  }
  .pk-file {
    text-align: left;
    width: 100%;
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 14px 18px;
    border: 0;
    border-bottom: 1px solid var(--pk-line-2);
    background: transparent;
    transition: background 0.15s;
  }
  .pk-file:hover {
    background: rgba(255, 255, 255, 0.5);
  }
  .pk-file.is-active {
    background: #fff;
    box-shadow: inset 3px 0 0 var(--pk-accent);
  }
  .pk-file-n {
    flex: none;
    width: 24px;
    height: 24px;
    border-radius: 6px;
    background: #efeadd;
    border: 1px solid #e0d9c7;
    font-family: var(--mono);
    font-size: 10.5px;
    color: #8a8069;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 1px;
  }
  .pk-file-title {
    display: block;
    font-weight: 600;
    font-size: 14px;
    color: var(--pk-ink);
  }
  .pk-file-tag {
    display: block;
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--pk-faint);
    margin-top: 3px;
  }

  /* Right panel */
  .pk-panel {
    padding: 32px;
    background: var(--pk-surface);
    min-width: 0;
  }
  .pk-slot[hidden] {
    display: none;
  }
  .pk-slot-meta {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    color: var(--pk-faint);
  }
  .pk-slot-title {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 28px;
    margin: 8px 0 6px;
    color: var(--pk-ink);
  }
  .pk-slot-desc {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--pk-muted);
    max-width: 560px;
    margin: 0 0 24px;
  }

  @media (max-width: 900px) {
    .pk {
      padding: 88px 0;
    }
    .pk-viewer {
      grid-template-columns: 1fr;
    }
    .pk-rail {
      border-right: none;
      border-bottom: 1px solid var(--pk-line);
      display: flex;
      flex-wrap: wrap;
      align-items: stretch;
    }
    .pk-rail-head {
      flex-basis: 100%;
    }
    .pk-file {
      flex: 1 1 auto;
      border-bottom: none;
      border-right: 1px solid var(--pk-line-2);
    }
    .pk-file.is-active {
      box-shadow: inset 0 3px 0 var(--pk-accent);
    }
    .pk-panel {
      padding: 24px;
    }
  }
</style>
