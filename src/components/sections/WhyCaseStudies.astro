---
import SectionHead from '../SectionHead.astro';

interface Reason {
  num: string;
  label: string;
  title: string;
  body: string;
}

const reasons: Reason[] = [
  {
    num: '01',
    label: 'Trust',
    title: 'Build <em>trust</em>.',
    body: 'Case studies tell skeptical B2B buyers why they should choose you, from someone they believe. A real customer story beats any marketing copy.',
  },
  {
    num: '02',
    label: 'SEO & GEO',
    title: 'Improve <em>SEO &amp; GEO</em>.',
    body: 'Case studies are evergreen content that compounds over time. They improve your search ranking and get you talked about favourably by LLMs.',
  },
  {
    num: '03',
    label: 'CAC',
    title: 'Lower <em>CAC</em>.',
    body: 'Proof-driven content shortens the sales cycle. Prospects arrive already convinced, fewer calls to close, lower cost per customer.',
  },
];
---

<section id="why" aria-labelledby="why-h">
  <div class="wrap">
    <SectionHead title="Why <em>case studies</em>?" />
    <p id="why-h" class="lede">
      Case studies are one of the highest-performing content types for B2B SaaS. Here's what they can do for you.
    </p>
    <div class="why">
      {reasons.map((r) => (
        <div class="card">
          <div class="num">
            <span class="pip" aria-hidden="true"></span>
            <span>{r.num}</span>
            <span>·</span>
            <span>{r.label}</span>
          </div>
          <h3 set:html={r.title} />
          <p>{r.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  section {
    padding: 120px 0;
    background: var(--yellow);
    border-bottom: 1px solid var(--ink);
  }
  .lede {
    font-size: 21px;
    line-height: 1.45;
    max-width: 64ch;
    margin: 0 0 56px;
    color: var(--ink);
  }
  .why {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border-top: 1px solid var(--ink);
  }
  .card {
    padding: 48px 36px 48px 0;
    border-right: 1px solid rgba(28, 27, 24, 0.18);
    position: relative;
  }
  .card:nth-child(n + 2) {
    padding-left: 36px;
  }
  .card:last-child {
    border-right: none;
    padding-right: 0;
  }
  .num {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    font-weight: 500;
    margin-bottom: 36px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .pip {
    width: 8px;
    height: 8px;
    display: inline-block;
    background: var(--ink);
  }
  h3 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 36px;
    line-height: 1.05;
    letter-spacing: -0.015em;
    margin: 0 0 18px;
  }
  h3 :global(em) {
    font-style: italic;
  }
  p {
    margin: 0;
    font-size: 18px;
    line-height: 1.55;
    color: var(--ink);
    max-width: 42ch;
  }
  @media (max-width: 900px) {
    .why {
      grid-template-columns: 1fr;
    }
    .card {
      border-right: none;
      border-bottom: 1px solid rgba(28, 27, 24, 0.18);
      padding: 40px 0;
    }
    .card:nth-child(n + 2) {
      padding-left: 0;
    }
    .card:last-child {
      border-bottom: none;
    }
  }
</style>
