---
import Button from '../Button.astro';
---

<section id="contact-bottom" class="close">
  <div class="wrap">
    <p class="eyebrow"><em>Your move.</em></p>
    <h2>Send us a case study. We'll tell you what's <span class="yel">broken</span>.</h2>
    <p class="aside">
      Free written audit. No call required. Five business days.
    </p>
    <div class="ctas">
      <Button href="mailto:jon@bestcasestud.io" variant="primary">Email us your case study</Button>
    </div>
  </div>
</section>

<style>
  .close {
    background: var(--ink);
    color: var(--bg);
    padding: 140px 0;
  }
  .eyebrow {
    font-family: var(--serif);
    font-size: 18px;
    font-style: italic;
    color: #bdb7a8;
    margin: 0 0 20px;
  }
  h2 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(56px, 7vw, 108px);
    line-height: 1;
    letter-spacing: -0.02em;
    max-width: 18ch;
    margin: 0 0 40px;
    color: var(--bg);
  }
  h2 .yel {
    background: var(--yellow);
    color: var(--ink);
    padding: 0 0.12em 0.04em;
    display: inline-block;
  }
  .aside {
    color: #bdb7a8;
    font-size: 18px;
    line-height: 1.55;
    max-width: 54ch;
    margin: 0 0 40px;
  }
  .ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .close :global(.btn) {
    border-color: var(--bg);
    color: var(--bg);
  }
  .close :global(.btn.primary) {
    background: var(--pink);
    color: var(--ink);
    border-color: var(--pink);
  }
  .close :global(.btn.primary:hover) {
    background: var(--pink);
  }
</style>
