---
import Button from '../Button.astro';
---

<section id="contact-bottom" class="close">
  <div class="wrap">
    <p class="eyebrow"><em>Your move.</em></p>
    <h2>Your best customer already said the thing that closes your next <span class="yel">deal</span>.</h2>
    <p class="aside">
      You just haven't captured it yet. One intro. One conversation. A complete Proof Kit in two weeks — for $2,500.
    </p>
    <div class="ctas">
      <Button href="/contact/" variant="primary">Book a call</Button>
      <Button href="/examples/" variant="secondary">See a real example first</Button>
    </div>
    <p class="soft-note">Or send us a case study you've already got and we'll tell you, free, what's letting it down. <a href="mailto:jon@bestcasestud.io">Email Jon →</a></p>
  </div>
</section>

<style>
  .close {
    background: var(--ink);
    color: var(--bg);
    padding: 140px 0;
  }
  .eyebrow {
    font-family: var(--serif);
    font-size: 18px;
    font-style: italic;
    color: #bdb7a8;
    margin: 0 0 20px;
  }
  h2 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(56px, 7vw, 108px);
    line-height: 1;
    letter-spacing: -0.02em;
    max-width: 18ch;
    margin: 0 0 40px;
    color: var(--bg);
  }
  h2 .yel {
    background: var(--yellow);
    color: var(--ink);
    padding: 0 0.12em 0.04em;
    display: inline-block;
  }
  .aside {
    color: #bdb7a8;
    font-size: 18px;
    line-height: 1.55;
    max-width: 54ch;
    margin: 0 0 40px;
  }
  .ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .close :global(.btn) {
    border-color: var(--bg);
    color: var(--bg);
  }
  .close :global(.btn.primary) {
    background: var(--pink);
    color: var(--ink);
    border-color: var(--pink);
  }
  .close :global(.btn.primary:hover) {
    background: var(--pink);
  }
  .soft-note {
    margin: 28px 0 0;
    font-size: 15px;
    color: #bdb7a8;
    font-style: italic;
  }
  .soft-note a {
    color: var(--bg);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
