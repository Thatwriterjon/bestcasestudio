---
import SectionHead from '../SectionHead.astro';
import Button from '../Button.astro';

const optimiseIncluded = [
  'We audit your existing case study against the Citable Case Study format.',
  'We rewrite it across all four structural layers: Atomic Answer, Stakeholder Narrative, Evidence Layer, Structured Data.',
  'We supply the JSON-LD schema markup.',
  'Delivered as clean markdown, ready for your team to publish.',
  'One consolidated round of revisions.',
];

const buildIncluded = [
  'We run the customer interview ourselves. 30 minutes, remote, on Riverside. We schedule it.',
  'We pull the verified metrics and write the full Citable Case Study.',
  'We supply the JSON-LD schema markup.',
  'We edit the interview footage into a companion video.',
  'Delivered as clean markdown plus video file.',
  'One consolidated round of revisions.',
];

---

<section id="pricing">
  <div class="wrap">
    <SectionHead title="<em>Pricing</em>." />
    <p class="lede">
      Two ways to work together.
    </p>
    <p class="sub-lede">Both deliver the Citable Case Study. Both priced per case study. Volume discounts on three or more.</p>

    <div class="pricing-grid">
      <div class="pricing-card">
        <div class="pricing-inner">
          <span class="eyebrow"><span class="pip" aria-hidden="true"></span>Optimise</span>
          <h3><em>Optimise</em> an existing case study.</h3>
          <p class="price-lede">For case studies that aren't earning their place on your website.</p>
          <div class="price-spacer"></div>
          <span class="price">$750</span>
          <div class="included">
            <h4>What's included</h4>
            <ul>
              {optimiseIncluded.map((item) => (
                <li><span>{item}</span></li>
              ))}
            </ul>
          </div>
          <div class="turnaround">
            <span class="k">Turnaround</span>
            <span class="v"><em>14 business days.</em></span>
          </div>
          <Button href="/#audit" variant="primary">Start with an audit</Button>
        </div>
      </div>

      <div class="pricing-card featured">
        <div class="pricing-inner">
          <span class="eyebrow"><span class="pip" aria-hidden="true"></span>Build</span>
          <h3><em>Build</em> a new case study from scratch.</h3>
          <p class="price-lede">For when you need a case study and your team doesn't have the bandwidth to produce it.</p>
          <div class="price-spacer"></div>
          <span class="price">$2,500</span>
          <div class="included">
            <h4>What's included</h4>
            <ul>
              {buildIncluded.map((item) => (
                <li><span>{item}</span></li>
              ))}
            </ul>
          </div>
          <div class="turnaround">
            <span class="k">Turnaround</span>
            <span class="v"><em>14 business days</em> from interview to first drafts.</span>
          </div>
          <Button href="/#audit" variant="primary">Commission a case study</Button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  section {
    padding: 120px 0;
    background: var(--ink);
    color: var(--bg);
  }
  section :global(.sec-head h2) {
    color: var(--bg);
  }
  section :global(.sec-head h2 em) {
    color: var(--pink);
  }
  section :global(.sec-num) {
    color: #8a857a;
  }
  .lede {
    font-size: 21px;
    line-height: 1.45;
    max-width: 64ch;
    margin: 0;
    color: #cfcabd;
  }
  .sub-lede {
    font-size: 18px;
    line-height: 1.45;
    max-width: 64ch;
    margin: 8px 0 0;
    color: #cfcabd;
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    margin-top: 48px;
  }

  .pricing-card {
    background: var(--bg);
    color: var(--ink);
  }
  .pricing-card.featured {
    border: 2px solid var(--pink);
  }
  .pricing-inner {
    padding: 48px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .eyebrow {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .eyebrow .pip {
    width: 8px;
    height: 8px;
    background: var(--pink);
    display: inline-block;
  }
  .pricing-card h3 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 36px;
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin: 0;
    max-width: 18ch;
  }
  .pricing-card h3 :global(em) {
    font-style: italic;
  }
  .price-lede {
    font-family: var(--serif);
    font-style: italic;
    color: var(--ink-soft);
    font-size: 17px;
    line-height: 1.45;
    margin: 0;
    max-width: 36ch;
  }
  .price-spacer {
    flex: 1;
    min-height: 8px;
  }
  .price {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(72px, 9vw, 120px);
    line-height: 0.85;
    letter-spacing: -0.04em;
    font-style: italic;
    background: var(--yellow);
    padding: 0 0.14em 0.04em;
    display: inline-block;
    color: var(--ink);
    align-self: flex-start;
  }

  .included h4 {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    font-weight: 500;
    margin: 0 0 16px;
  }
  .included ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    counter-reset: price-item;
  }
  .included li {
    font-family: var(--serif);
    font-size: 16px;
    line-height: 1.45;
    display: grid;
    grid-template-columns: 36px 1fr;
    align-items: baseline;
    padding: 10px 0;
    border-bottom: 1px solid var(--rule);
  }
  .included li:last-child {
    border-bottom: none;
  }
  .included li::before {
    counter-increment: price-item;
    content: counter(price-item, decimal-leading-zero);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--ink-soft);
    font-weight: 500;
  }

  .turnaround {
    padding-top: 8px;
    border-top: 1px solid var(--rule);
  }
  .turnaround .k {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    font-weight: 500;
    display: block;
    margin-bottom: 4px;
  }
  .turnaround .v {
    font-family: var(--serif);
    font-size: 16px;
    line-height: 1.45;
    color: var(--ink);
  }
  .turnaround .v :global(em) {
    font-style: italic;
  }

  .pricing-inner :global(.btn) {
    align-self: flex-start;
    margin-top: 8px;
  }

  @media (max-width: 900px) {
    .pricing-grid {
      grid-template-columns: 1fr;
    }
    .pricing-inner {
      padding: 36px;
    }
    .price {
      font-size: clamp(64px, 14vw, 100px);
    }
  }
</style>
