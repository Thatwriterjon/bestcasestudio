---
import SectionHead from '../SectionHead.astro';
import Button from '../Button.astro';

const included = [
  'Video case study — the full story, on camera, in your customer\'s own words',
  'Written case study — built to rank on Google and get cited by AI',
  'Video testimonial — a short, sharp cut for your homepage and socials',
  'Written testimonial — a pull-quote for your site, deck, and emails',
  'Social pack — LinkedIn carousel and short clips',
  'A "how to use it" guide — where each piece does the most damage',
];
---

<section id="pricing">
  <div class="wrap">
    <SectionHead title="One package. <em>One price.</em>" />

    <div class="pricing-grid">
      <div class="pricing-card featured">
        <div class="pricing-inner">
          <span class="eyebrow"><span class="pip" aria-hidden="true"></span>The Proof Kit</span>
          <h3>Everything above. <em>One price.</em></h3>
          <div class="price-spacer"></div>
          <div class="price-row">
            <span class="price">$2,500</span>
          </div>
          <span class="delivery-badge">Delivered 14 days from the interview</span>
          <div class="included">
            <h4>What's included</h4>
            <ul>
              {included.map((item) => (
                <li><span>{item}</span></li>
              ))}
            </ul>
          </div>
          <p class="compare">Buy proof anywhere else in pieces and you'll spend $7,000–$10,000 before you've got a fraction of this. We productised the whole thing so you don't have to.</p>
          <Button href="/contact/" variant="primary">Book a call</Button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  section {
    padding: 120px 0;
    background: var(--ink);
    color: var(--bg);
  }
  section :global(.sec-head h2) {
    color: var(--bg);
  }
  section :global(.sec-head h2 em) {
    color: var(--pink);
  }
  section :global(.sec-num) {
    color: #8a857a;
  }
  .pricing-grid {
    margin-top: 48px;
    display: flex;
    justify-content: center;
  }

  .pricing-card {
    background: var(--bg);
    color: var(--ink);
    max-width: 640px;
    width: 100%;
  }
  .pricing-card.featured {
    border: 2px solid var(--pink);
  }
  .pricing-inner {
    padding: 56px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .eyebrow {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .eyebrow .pip {
    width: 8px;
    height: 8px;
    background: var(--pink);
    display: inline-block;
  }
  .pricing-card h3 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 36px;
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin: 0;
    max-width: 18ch;
  }
  .pricing-card h3 :global(em) {
    font-style: italic;
  }
  .price-spacer {
    flex: 1;
    min-height: 8px;
  }

  .price-row {
    display: flex;
    align-items: baseline;
    gap: 16px;
  }
  .price {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(60px, 7.5vw, 96px);
    line-height: 0.85;
    letter-spacing: -0.04em;
    font-style: italic;
    background: var(--yellow);
    padding: 0 0.14em 0.04em;
    display: inline-block;
    color: var(--ink);
  }
  .delivery-badge {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--pink);
    font-weight: 500;
    display: block;
  }

  .included h4 {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    font-weight: 500;
    margin: 0 0 16px;
  }
  .included ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    counter-reset: price-item;
  }
  .included li {
    font-family: var(--serif);
    font-size: 16px;
    line-height: 1.45;
    display: grid;
    grid-template-columns: 36px 1fr;
    align-items: baseline;
    padding: 10px 0;
    border-bottom: 1px solid var(--rule);
  }
  .included li:last-child {
    border-bottom: none;
  }
  .included li::before {
    counter-increment: price-item;
    content: counter(price-item, decimal-leading-zero);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--ink-soft);
    font-weight: 500;
  }

  .compare {
    font-family: var(--serif);
    font-style: italic;
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink-soft);
    margin: 0;
  }

  .pricing-inner :global(.btn) {
    align-self: flex-start;
    margin-top: 8px;
  }

  @media (max-width: 900px) {
    .pricing-inner {
      padding: 36px;
    }
    .price {
      font-size: clamp(52px, 12vw, 80px);
    }
  }
</style>
