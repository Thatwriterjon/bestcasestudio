---
import SectionHead from '../SectionHead.astro';
import Button from '../Button.astro';
import { pricingConfig } from '../../data/pricing.config';

const { written, video, monthly, guideNote } = pricingConfig;
---

<section id="pricing">
  <div class="wrap">
    <SectionHead title="Two things we make. <em>One way to buy more.</em>" />

    <div class="pricing-grid">
      <div class="pricing-card">
        <div class="pricing-inner">
          <span class="eyebrow"><span class="pip" aria-hidden="true"></span>{written.name}</span>
          <h3>From the ask to your <em>approval</em>.</h3>
          <div class="price-spacer"></div>
          <div class="price-row">
            <span class="price">{written.price}</span>
          </div>
          <span class="delivery-badge">Delivered {written.deliveryTime}</span>
          <div class="included">
            <h4>What you get</h4>
            <ul>
              {written.features.map((item) => (
                <li><span>{item}</span></li>
              ))}
            </ul>
          </div>
          <Button href="/contact/" variant="primary">Book a call</Button>
        </div>
      </div>

      <div class="pricing-card featured">
        <div class="pricing-inner">
          <span class="eyebrow"><span class="pip" aria-hidden="true"></span>{video.name}</span>
          <h3>Written, video <em>and social</em>.</h3>
          <div class="price-spacer"></div>
          <div class="price-row">
            <span class="price">{video.price}</span>
          </div>
          <span class="delivery-badge">Delivered {video.deliveryTime}</span>
          <div class="included">
            <h4>What you get</h4>
            <ul>
              {video.features.map((item) => (
                <li><span>{item}</span></li>
              ))}
            </ul>
          </div>
          <Button href="/contact/" variant="primary">Book a call</Button>
        </div>
      </div>
    </div>

    <p class="guide-note">{guideNote}</p>

    <div class="monthly-band">
      <span class="monthly-label">Buying more than one?</span>
      <p>
        The monthly plan: {monthly.storiesPerMonth} stories a month, either type, {monthly.discountPercent}% off.
        {monthly.rollover} <strong>{monthly.writtenPrice}</strong> for two written, or <strong>{monthly.videoPrice}</strong> for two video.
      </p>
    </div>
  </div>
</section>

<style>
  section {
    padding: 120px 0;
    background: var(--ink);
    color: var(--bg);
  }
  section :global(.sec-head h2) {
    color: var(--bg);
  }
  section :global(.sec-head h2 em) {
    color: var(--pink);
  }
  section :global(.sec-num) {
    color: #8a857a;
  }
  .pricing-grid {
    margin-top: 48px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
  }

  .pricing-card {
    background: var(--bg);
    color: var(--ink);
    width: 100%;
  }
  .pricing-card.featured {
    border: 2px solid var(--pink);
  }
  .pricing-inner {
    padding: 48px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    height: 100%;
  }
  .eyebrow {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .eyebrow .pip {
    width: 8px;
    height: 8px;
    background: var(--pink);
    display: inline-block;
  }
  .pricing-card h3 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 32px;
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0;
    max-width: 18ch;
  }
  .pricing-card h3 :global(em) {
    font-style: italic;
  }
  .price-spacer {
    flex: 1;
    min-height: 4px;
  }

  .price-row {
    display: flex;
    align-items: baseline;
    gap: 16px;
  }
  .price {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(48px, 6vw, 72px);
    line-height: 0.85;
    letter-spacing: -0.04em;
    font-style: italic;
    background: var(--yellow);
    padding: 0 0.14em 0.04em;
    display: inline-block;
    color: var(--ink);
  }
  .delivery-badge {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--pink);
    font-weight: 500;
    display: block;
  }

  .included h4 {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    font-weight: 500;
    margin: 0 0 16px;
  }
  .included ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    counter-reset: price-item;
  }
  .included li {
    font-family: var(--serif);
    font-size: 15px;
    line-height: 1.45;
    display: grid;
    grid-template-columns: 30px 1fr;
    align-items: baseline;
    padding: 9px 0;
    border-bottom: 1px solid var(--rule);
  }
  .included li:last-child {
    border-bottom: none;
  }
  .included li::before {
    counter-increment: price-item;
    content: counter(price-item, decimal-leading-zero);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--ink-soft);
    font-weight: 500;
  }

  .pricing-inner :global(.btn) {
    align-self: flex-start;
    margin-top: auto;
  }

  .guide-note {
    margin: 32px 0 0;
    font-family: var(--serif);
    font-style: italic;
    font-size: 15px;
    line-height: 1.5;
    color: #cfcabd;
    max-width: 60ch;
  }

  .monthly-band {
    margin-top: 40px;
    padding-top: 32px;
    border-top: 1px solid rgba(246, 243, 236, 0.2);
  }
  .monthly-label {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--pink);
    font-weight: 500;
    display: block;
    margin-bottom: 10px;
  }
  .monthly-band p {
    margin: 0;
    font-size: 17px;
    line-height: 1.5;
    max-width: 60ch;
    color: var(--bg);
  }
  .monthly-band p strong {
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .pricing-grid {
      grid-template-columns: 1fr;
    }
    .pricing-inner {
      padding: 36px;
    }
    .price {
      font-size: clamp(44px, 10vw, 64px);
    }
  }
</style>
