---
import SectionHead from '../SectionHead.astro';
import Button from '../Button.astro';

const included = [
  'Customer interview, 30 minutes, recorded on Riverside. <em>We schedule it.</em>',
  'Written case study, 800–1,200 words.',
  'PDF version for sales use.',
  'Highlight video, 90 seconds to 2 minutes, edited.',
  'Three quote graphics for social.',
  'One launch LinkedIn post, written for the client to publish.',
  'Two pull-quote excerpts ready for sales decks.',
  'One round of revision after consolidated feedback.',
];
---

<section id="pricing">
  <div class="wrap">
    <SectionHead title="<em>Pricing</em>." />
    <p class="lede">
      One product. Clear price. Everything you need to publish one case study, fully produced.
    </p>

    <div class="pricing-card">
      <div class="pricing-top">
        <div class="pricing-left">
          <span class="eyebrow"><span class="pip" aria-hidden="true"></span>Best Case Studio</span>
          <h3>The <em>Case Study</em>.</h3>
          <p class="price-lede">
            One customer. One story. Video, written page, social assets, fully produced and delivered.
          </p>
          <div class="price-spacer"></div>
          <span class="price">$2,500</span>
          <Button href="/contact" variant="primary">Book a discovery call</Button>
        </div>
        <div class="pricing-right">
          <h4>What's included</h4>
          <ul>
            {included.map((item) => (
              <li><span set:html={item} /></li>
            ))}
          </ul>
        </div>
      </div>
      <div class="pricing-meta">
        <div>
          <span class="k">Turnaround</span>
          <span class="v"><em>14 business days</em> from interview to first drafts.</span>
        </div>
        <div>
          <span class="k">Division of labour</span>
          <span class="v">Client handles customer-side approvals. We handle everything else, including scheduling the interview.</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  section {
    padding: 120px 0;
    background: var(--ink);
    color: var(--bg);
    border-bottom: 1px solid var(--ink);
  }
  section :global(.sec-head h2) {
    color: var(--bg);
  }
  section :global(.sec-head h2 em) {
    color: var(--pink);
  }
  section :global(.sec-num) {
    color: #8a857a;
  }
  .lede {
    font-size: 21px;
    line-height: 1.45;
    max-width: 64ch;
    margin: 0;
    color: #cfcabd;
  }

  .pricing-card {
    border: 1px solid var(--ink);
    background: var(--bg);
    color: var(--ink);
    margin-top: 48px;
  }
  .pricing-top {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 0;
  }
  .pricing-left {
    padding: 48px;
    border-right: 1px solid var(--ink);
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-height: 520px;
  }
  .pricing-right {
    padding: 48px;
  }
  .eyebrow {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .eyebrow .pip {
    width: 8px;
    height: 8px;
    background: var(--pink);
    display: inline-block;
  }
  .pricing-card h3 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 56px;
    line-height: 0.98;
    letter-spacing: -0.02em;
    margin: 0;
    max-width: 14ch;
  }
  .pricing-card h3 :global(em) {
    font-style: italic;
  }
  .price-lede {
    font-family: var(--serif);
    font-style: italic;
    color: var(--ink-soft);
    font-size: 18px;
    line-height: 1.45;
    margin: 0;
    max-width: 36ch;
  }
  .price-spacer {
    flex: 1;
  }
  .price {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(96px, 11vw, 156px);
    line-height: 0.85;
    letter-spacing: -0.04em;
    font-style: italic;
    background: var(--yellow);
    padding: 0 0.14em 0.04em;
    display: inline-block;
    color: var(--ink);
    align-self: flex-start;
  }
  .pricing-left :global(.btn) {
    align-self: flex-start;
    margin-top: 8px;
  }

  .pricing-right h4 {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    font-weight: 500;
    margin: 0 0 24px;
  }
  .pricing-right ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    counter-reset: price-item;
  }
  .pricing-right li {
    font-family: var(--serif);
    font-size: 17px;
    line-height: 1.45;
    display: grid;
    grid-template-columns: 44px 1fr;
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
  }
  .pricing-right li:last-child {
    border-bottom: none;
  }
  .pricing-right li::before {
    counter-increment: price-item;
    content: counter(price-item, decimal-leading-zero);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--ink-soft);
    font-weight: 500;
  }
  .pricing-right li :global(em) {
    font-style: italic;
  }

  .pricing-meta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    padding: 32px 48px;
    border-top: 1px solid var(--ink);
    background: var(--bg-2);
  }
  .pricing-meta .k {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    font-weight: 500;
    display: block;
    margin-bottom: 6px;
  }
  .pricing-meta .v {
    font-family: var(--serif);
    font-size: 17px;
    line-height: 1.45;
    color: var(--ink);
  }
  .pricing-meta .v :global(em) {
    font-style: italic;
  }

  @media (max-width: 900px) {
    .pricing-top {
      grid-template-columns: 1fr;
    }
    .pricing-left {
      border-right: none;
      border-bottom: 1px solid var(--ink);
      min-height: 0;
      padding: 36px;
    }
    .pricing-right {
      padding: 36px;
    }
    .pricing-meta {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 28px 36px;
    }
  }
</style>
