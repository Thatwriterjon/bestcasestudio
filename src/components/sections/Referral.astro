---
import Button from '../Button.astro';
---

<section class="referral" aria-label="Referral programme">
  <div class="wrap ref-inner">
    <div>
      <div class="eyebrow">
        <span class="pip" aria-hidden="true"></span>Referral Programme
      </div>
      <h2>
        Earn <span class="pink">$500</span> per referral. <em>No cap.</em>
      </h2>
      <p>
        Know a B2B SaaS company that needs case studies? Make the introduction. When they pay their first invoice, we send you $500 cash. No forms, no limits.
      </p>
      <div class="ctas">
        <Button href="mailto:jon@bestcasestud.io">Email us to refer someone</Button>
      </div>
    </div>
    <div class="price-tag" aria-hidden="true">
      <div class="v">$500</div>
      <div class="k">Per referral · No cap</div>
    </div>
  </div>
</section>

<style>
  .referral {
    padding: 120px 0;
    background: var(--yellow);
    color: var(--ink);
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    position: relative;
    overflow: hidden;
  }
  .ref-inner {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 64px;
    align-items: center;
  }
  .eyebrow {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
    font-weight: 500;
    margin-bottom: 20px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .eyebrow .pip {
    width: 8px;
    height: 8px;
    background: var(--pink);
    display: inline-block;
  }
  h2 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(48px, 6.5vw, 108px);
    line-height: 0.95;
    letter-spacing: -0.025em;
    margin: 0 0 24px;
  }
  h2 em {
    font-style: italic;
  }
  h2 .pink {
    background: var(--pink);
    padding: 0 0.12em 0.04em;
    display: inline-block;
  }
  p {
    font-size: 19px;
    line-height: 1.55;
    color: var(--ink);
    margin: 0 0 32px;
    max-width: 44ch;
  }
  .price-tag {
    padding: 48px 40px;
    border: 1px solid var(--ink);
    background: var(--bg);
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: flex-start;
  }
  .price-tag .v {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(96px, 13vw, 160px);
    line-height: 0.85;
    letter-spacing: -0.04em;
    font-style: italic;
    color: var(--ink);
  }
  .price-tag .k {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    font-weight: 500;
  }
  @media (max-width: 900px) {
    .ref-inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
