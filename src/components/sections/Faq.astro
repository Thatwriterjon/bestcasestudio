---
import { getCollection } from 'astro:content';
import SectionHead from '../SectionHead.astro';

const items = (await getCollection('faq')).sort((a, b) => a.data.order - b.data.order);

/** Strip basic inline HTML (e.g. <em>) so the schema text matches the plain rendered question/answer. */
const stripHtml = (s: string) => s.replace(/<[^>]*>/g, '');

const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: items.map(({ data: q }) => ({
    '@type': 'Question',
    name: stripHtml(q.question),
    acceptedAnswer: {
      '@type': 'Answer',
      text: q.answer.map((p) => stripHtml(p)).join('\n\n'),
    },
  })),
};
---

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify({ '@context': 'https://schema.org', ...faqSchema })}
/>

<section id="faq" class="faq">
  <div class="wrap-tight">
    <SectionHead title="Frequently asked <em>questions</em>." compact />
    <p class="lede">Everything you need to know before sending us a case study.</p>
    <div class="faq-list">
      {items.map(({ data: q }) => (
        <details class="q">
          <summary>
            <span set:html={q.question} />
            <span class="marker" aria-hidden="true">+</span>
          </summary>
          <div class="a">
            {q.answer.map((p) => <p set:html={p} />)}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    padding: 120px 0;
    background: var(--bg);
    border-bottom: 1px solid var(--rule);
  }
  .lede {
    font-size: 19px;
    line-height: 1.45;
    max-width: 60ch;
    margin: 0 0 40px;
    color: var(--ink-soft);
  }
  .faq-list {
    border-top: 1px solid var(--ink);
  }
  details.q {
    border-bottom: 1px solid var(--rule);
    padding: 0;
  }
  details.q summary {
    list-style: none;
    padding: 28px 0;
    cursor: pointer;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 32px;
    font-family: var(--serif);
    font-weight: 500;
    font-size: 24px;
    line-height: 1.25;
    letter-spacing: -0.01em;
    transition: color 0.15s;
  }
  details.q summary::-webkit-details-marker {
    display: none;
  }
  details.q summary :global(em) {
    font-style: italic;
  }
  details.q .marker {
    flex: 0 0 32px;
    text-align: right;
    font-family: var(--serif);
    font-weight: 400;
    font-size: 32px;
    line-height: 1;
    color: var(--ink);
    transition: transform 0.2s;
    font-style: italic;
  }
  details.q[open] .marker {
    transform: rotate(45deg);
  }
  details.q .a {
    padding: 0 0 32px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink);
    max-width: 72ch;
  }
  details.q .a p {
    margin: 0 0 14px;
  }
  details.q .a p:last-child {
    margin-bottom: 0;
  }
  details.q .a :global(em) {
    font-style: italic;
  }
</style>
