---
import SectionHead from '../SectionHead.astro';

interface Layer {
  num: string;
  title: string;
  body: string;
}

const layers: Layer[] = [
  {
    num: '01',
    title: 'The Atomic <em>Answer</em>.',
    body: 'The first 120 words form a self-contained citation block: named customer, problem, solution, headline metric with date and attribution. The exact format AI engines extract when a buyer asks for examples in your category. Most case studies bury this. Ours opens with it.',
  },
  {
    num: '02',
    title: 'The Stakeholder <em>Narrative</em>.',
    body: 'The story, organised around question-shaped H2s that match how buyers actually search. Built from named voices with credentials, not anonymous marketing prose.',
  },
  {
    num: '03',
    title: 'The Evidence <em>Layer</em>.',
    body: 'Verifiable metrics, attributed to real people, with dates and context. The kind of proof that holds up to a sceptical buyer and a fact-checking AI.',
  },
  {
    num: '04',
    title: 'The Structured Data <em>Layer</em>.',
    body: 'JSON-LD schema describing the case study as an Article, the customer as an Organization, the result as a quantifiable Outcome. Alt text, semantic HTML, the infrastructure that tells search engines and AI crawlers exactly what they\'re reading.',
  },
];
---

<section id="methodology">
  <div class="wrap">
    <SectionHead title="What is a Citable <em>Case Study</em>?" />
    <p class="lede">A B2B case study built for the three places it now has to work — Google, ChatGPT, and the buyer on the page. Every Citable Case Study has four structural layers.</p>
    <div class="layers">
      {layers.map((l) => (
        <div class="layer">
          <span class="num">{l.num}</span>
          <h4 set:html={l.title} />
          <p>{l.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  section {
    padding: 120px 0;
    background: var(--bg);
    border-bottom: 1px solid var(--rule);
  }
  .lede {
    font-size: 21px;
    line-height: 1.45;
    max-width: 64ch;
    margin: 0 0 56px;
    color: var(--ink);
  }
  .layers {
    border-top: 1px solid var(--ink);
  }
  .layer {
    display: grid;
    grid-template-columns: 80px 1fr 1.4fr;
    gap: 32px;
    padding: 36px 0;
    border-bottom: 1px solid var(--rule);
    align-items: start;
    transition: background 0.2s;
    cursor: default;
  }
  .layer:hover {
    background: var(--yellow);
  }
  .layer .num {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--ink-soft);
    text-transform: uppercase;
    padding-top: 14px;
  }
  .layer h4 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 36px;
    line-height: 1.02;
    letter-spacing: -0.015em;
    margin: 0;
    max-width: 14ch;
  }
  .layer h4 :global(em) {
    font-style: italic;
  }
  .layer p {
    margin: 0;
    font-size: 17px;
    line-height: 1.55;
    color: var(--ink);
    max-width: 46ch;
    padding-top: 8px;
  }
  @media (max-width: 900px) {
    .layer {
      grid-template-columns: 60px 1fr;
      gap: 16px 20px;
    }
    .layer h4 {
      grid-column: 2;
    }
    .layer p {
      grid-column: 2;
    }
  }
</style>
