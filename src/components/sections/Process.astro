---
import SectionHead from '../SectionHead.astro';

interface Layer {
  num: string;
  title: string;
  body: string;
}

const layers: Layer[] = [
  {
    num: '01',
    title: 'Video case <em>study</em>.',
    body: 'The full story, in your customer\'s own words, on camera. This runs between 2 and 4 minutes, and is the MVP of the Proof Kit.',
  },
  {
    num: '02',
    title: 'Written case <em>study</em>.',
    body: 'The deep-dive version, optimised to rank on Google and get cited by AI, so your proof shows up the moment a buyer starts looking.',
  },
  {
    num: '03',
    title: 'Video <em>testimonial</em>.',
    body: 'A short, sharp cut for your homepage and socials. Thirty seconds-ish.',
  },
  {
    num: '04',
    title: 'Written <em>testimonial</em>.',
    body: 'A pull-quote ready to drop straight into your site, your deck, or your next cold email.',
  },
  {
    num: '05',
    title: 'Social <em>pack</em>.',
    body: 'A branded LinkedIn carousel and short clips, all cut from the same conversation. Can be posted as they are, or to support your written content.',
  },
  {
    num: '06',
    title: 'How-to <em>guide</em>.',
    body: 'A short walkthrough showing exactly where each piece works hardest, so it doesn\'t just sit in a folder.',
  },
];
---

<section id="whats-included">
  <div class="wrap">
    <SectionHead title="Your <em>Proof Kit</em>." />
    <p class="lede">You just make the introduction, and we take care of the rest. We record an interview with your client, and from that conversation we build you a treasure chest of trust-building assets.</p>
    <div class="layers">
      {layers.map((l) => (
        <div class="layer">
          <span class="num">{l.num}</span>
          <h4 set:html={l.title} />
          <p>{l.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  section {
    padding: 120px 0;
    background: var(--bg);
    border-bottom: 1px solid var(--rule);
  }
  .lede {
    font-size: 21px;
    line-height: 1.45;
    max-width: 64ch;
    margin: 0 0 56px;
    color: var(--ink);
  }
  .layers {
    border-top: 1px solid var(--ink);
  }
  .layer {
    display: grid;
    grid-template-columns: 80px 1fr 1.4fr;
    gap: 32px;
    padding: 36px 0;
    border-bottom: 1px solid var(--rule);
    align-items: start;
    transition: background 0.2s;
    cursor: default;
  }
  .layer:hover {
    background: var(--yellow);
  }
  .layer .num {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--ink-soft);
    text-transform: uppercase;
    padding-top: 14px;
  }
  .layer h4 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 36px;
    line-height: 1.02;
    letter-spacing: -0.015em;
    margin: 0;
    max-width: 14ch;
  }
  .layer h4 :global(em) {
    font-style: italic;
  }
  .layer p {
    margin: 0;
    font-size: 17px;
    line-height: 1.55;
    color: var(--ink);
    max-width: 46ch;
    padding-top: 8px;
  }
  @media (max-width: 900px) {
    .layer {
      grid-template-columns: 60px 1fr;
      gap: 16px 20px;
    }
    .layer h4 {
      grid-column: 2;
    }
    .layer p {
      grid-column: 2;
    }
  }
</style>
