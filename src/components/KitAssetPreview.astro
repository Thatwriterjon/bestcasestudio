    font-style: italic;
    font-size: 19px;
    line-height: 1.4;
    color: var(--pk-ink);
  }
  .kap-pullquote-a {
    font-size: 12.5px;
    color: var(--pk-muted);
    margin-top: 8px;
  }
  .kap-readmore {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 20px;
    padding: 13px;
    background: var(--pk-ink);
    color: var(--pk-panel);
    border-radius: 10px;
    font-weight: 600;
    font-size: 14px;
    text-decoration: none;
  }
  .kap-readmore:hover {
    background: #000;
    color: var(--pk-panel);
  }

  /* ---- Video testimonial ---- */
  .kap-testi {
    display: flex;
    gap: 20px;
    align-items: stretch;
    width: 100%;
    flex-wrap: wrap;
  }
  .kap-video--clip {
    width: 210px;
    flex: none;
    aspect-ratio: 4 / 5;
  }
  .kap-video--real video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--pk-dark);
  }
  .kap-dur--clip {
    position: absolute;
    left: 14px;
    bottom: 12px;
    padding: 2px 8px;
    font-size: 11px;
  }
  .kap-testi-copy {
    flex: 1;
    min-width: 220px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .kap-testi-lead {
    font-family: var(--serif);
    font-size: 24px;
    line-height: 1.25;
    color: var(--pk-ink);
    margin-top: 8px;
  }
  .kap-testi-desc {
    color: var(--pk-muted);
    font-size: 13.5px;
    line-height: 1.6;
    margin-top: 10px;
  }

  /* ---- Written testimonial ---- */
  .kap-quote {
    width: 100%;
    margin: 0;
    background: var(--pk-surface);
    border: 1px solid var(--pk-line);
    border-radius: 14px;
    padding: 26px 28px;
  }
  .kap-quote-mark {
    font-family: var(--serif);
    font-size: 52px;
    line-height: 0.2;
    color: var(--pk-accent);
    height: 26px;
  }
  .kap-quote-t {
