---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  /** '/blog' for standard posts, '/compare' for comparison pages. Controls the back link. */
  basePath?: string;
}

const { post, basePath = '/blog' } = Astro.props;
const { Content } = await render(post);

const dateStr = post.data.date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const isoDate = post.data.date.toISOString();
const cmp = post.data.comparison;

const isCompare = basePath === '/compare';
const backHref = isCompare ? '/compare/' : '/blog/';
const backLabel = isCompare ? '← All comparisons' : '← Blog';
---

<article class:list={['post', { 'is-comparison': cmp }]}>
  <header class="post-header">
    <div class="wrap-article">
      <a href={backHref} class="back mono">{backLabel}</a>
      {cmp && <p class="cmp-eyebrow mono">Comparison</p>}
      <h1>{post.data.title}</h1>
      <div class="post-meta mono">
        <span>{post.data.author}</span>
        <span aria-hidden="true">·</span>
        <time datetime={isoDate}>{dateStr}</time>
      </div>

      {cmp && (
        <div class="cmp-vs">
          <div class="cmp-panel cmp-us">
            <span class="cmp-badge mono">Best Case Studio</span>
            <p class="cmp-line">{cmp.us}</p>
            <span class="cmp-wedge mono">Our edge · {cmp.wedge}</span>
          </div>
          <div class="cmp-versus" aria-hidden="true"><span class="mono">vs</span></div>
          <div class="cmp-panel cmp-them">
            <span class="cmp-badge mono">{cmp.competitor}</span>
            <p class="cmp-line">{cmp.them}</p>
          </div>
        </div>
      )}
    </div>
  </header>

  <div class="post-body">
    <div class="wrap-article prose">
      <Content />
    </div>
  </div>

  <aside class="post-author">
    <div class="wrap-article">
      <div class="author-card">
        <div class="author-info">
          <p class="author-name">{post.data.author}</p>
          <p class="author-bio">
            Founder of Best Case Studio. Eight years experience writing copy and content for B2B
            SaaS companies including Google, Elastic, and Scoro. Co-host of the SaaSy as F*ck podcast.
          </p>
          <a href="https://www.linkedin.com/in/thatwriterjon/" class="author-link mono" rel="noopener" target="_blank">LinkedIn →</a>
        </div>
      </div>
    </div>
  </aside>

  {post.data.faq && post.data.faq.length > 0 && (
    <section class="post-faq">
      <div class="wrap-article">
        <h2>Frequently asked questions</h2>
        <dl class="faq-list">
          {post.data.faq.map((item) => (
            <div class="faq-item">
              <dt>{item.q}</dt>
              <dd>{item.a}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  )}

  <section class="post-cta">
    <div class="wrap-article">
      {cmp ? (
        <div class="cta-box cmp-cta">
          <h3>See what one conversation turns&nbsp;into.</h3>
          <p>
            A Proof Kit is a real customer, on the record: video and written case study, both
            testimonials, and a social pack, all from one interview. $2,500, delivered 14 days
            from the interview.
          </p>
          <div class="cta-actions">
            <a href="/examples/" class="cta-btn">See a real example →</a>
            <a href="/pricing/" class="cta-btn cta-btn--ghost">See pricing &amp; book a call</a>
          </div>
        </div>
      ) : (
        <div class="cta-box">
          <h3>Want a case study that earns its&nbsp;keep?</h3>
          <p>
            Book a free 30-minute discovery call. We'll audit one of your existing case studies
            live — no pitch, no obligation.
          </p>
          <a href="/contact/" class="cta-btn">Book a free audit →</a>
        </div>
      )}
    </div>
  </section>
</article>

<style>
  /* ---- Header ---- */
  .post-header {
    padding: 160px 0 48px;
  }
  .back {
    display: inline-block;
    color: var(--ink-soft);
    margin-bottom: 32px;
  }
  .back:hover {
    color: var(--ink);
  }
  .post-header h1 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(32px, 4.5vw, 52px);
    line-height: 1.06;
    letter-spacing: -0.02em;
    margin: 0 0 24px;
    max-width: 20ch;
  }
  .post-meta {
    color: var(--ink-soft);
    display: flex;
    gap: 10px;
  }

  /* ---- Prose (Markdown body) ---- */
  .post-body {
    padding-bottom: 64px;
  }

  .prose :global(h2) {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(24px, 2.8vw, 32px);
    line-height: 1.12;
    letter-spacing: -0.015em;
    margin: 56px 0 20px;
  }
  .prose :global(h3) {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 20px;
    line-height: 1.3;
    margin: 40px 0 12px;
  }
  .prose :global(p) {
    font-size: 19px;
    line-height: 1.62;
    margin: 0 0 18px;
  }
  .prose :global(ul),
  .prose :global(ol) {
    font-size: 19px;
    line-height: 1.62;
    margin: 0 0 18px;
    padding-left: 24px;
  }
  .prose :global(li) {
    margin-bottom: 8px;
  }
  .prose :global(li):last-child {
    margin-bottom: 0;
  }
  .prose :global(strong) {
    font-weight: 600;
  }
  .prose :global(em) {
    font-style: italic;
  }
  .prose :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--ink-faint);
  }
  .prose :global(a:hover) {
    text-decoration-color: var(--ink);
  }
  .prose :global(blockquote) {
    margin: 28px 0;
    padding: 4px 0 4px 24px;
    border-left: 3px solid var(--pink);
  }
  .prose :global(blockquote p) {
    font-style: italic;
    color: var(--ink-soft);
  }
  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--rule);
    margin: 48px 0;
  }
  .prose :global(code) {
    font-family: var(--mono);
    font-size: 14px;
    background: var(--bg-2);
    padding: 2px 6px;
    border-radius: 4px;
  }

  /* ---- Table ---- */
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 24px 0 28px;
    font-size: 15px;
    line-height: 1.45;
  }
  .prose :global(thead) {
    border-bottom: 2px solid var(--ink);
  }
  .prose :global(th) {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
    text-align: left;
    padding: 10px 14px 10px 0;
    white-space: nowrap;
  }
  .prose :global(td) {
    padding: 10px 14px 10px 0;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
  }
  .prose :global(tr td:first-child) {
    font-weight: 600;
    font-size: 14px;
    white-space: nowrap;
  }

  /* ---- Author ---- */
  .post-author {
    padding: 0 0 56px;
    border-top: 1px solid var(--rule);
    padding-top: 40px;
  }
  .author-card {
    display: flex;
    gap: 20px;
    align-items: flex-start;
  }
  .author-name {
    font-weight: 600;
    font-size: 17px;
    margin: 0 0 6px;
  }
  .author-bio {
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-soft);
    margin: 0 0 10px;
    max-width: 52ch;
  }
  .author-link {
    font-size: 12px;
    color: var(--ink-soft);
  }
  .author-link:hover {
    color: var(--ink);
  }

  /* ---- FAQ ---- */
  .post-faq {
    padding: 56px 0 48px;
    border-top: 1px solid var(--rule);
  }
  .post-faq h2 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(24px, 2.8vw, 32px);
    line-height: 1.12;
    letter-spacing: -0.015em;
    margin: 0 0 32px;
  }
  .faq-list {
    margin: 0;
  }
  .faq-item {
    padding: 24px 0;
    border-top: 1px solid var(--rule);
  }
  .faq-item:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .faq-item dt {
    font-weight: 600;
    font-size: 18px;
    line-height: 1.4;
    margin-bottom: 8px;
  }
  .faq-item dd {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  /* ---- CTA ---- */
  .post-cta {
    padding: 0 0 120px;
  }
  .cta-box {
    background: var(--ink);
    color: var(--bg);
    border-radius: 8px;
    padding: 48px;
    text-align: center;
  }
  .cta-box h3 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(24px, 3vw, 34px);
    line-height: 1.1;
    letter-spacing: -0.015em;
    margin: 0 0 16px;
    color: var(--bg);
  }
  .cta-box p {
    font-size: 17px;
    line-height: 1.55;
    color: #c8c3b6;
    margin: 0 0 28px;
    max-width: 48ch;
    margin-left: auto;
    margin-right: auto;
  }
  .cta-btn {
    display: inline-block;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 500;
    background: var(--bg);
    color: var(--ink);
    padding: 14px 28px;
    border-radius: 999px;
    text-decoration: none;
  }
  .cta-btn:hover {
    background: var(--pink);
  }

  /* ---- Comparison: versus hero ---- */
  .cmp-eyebrow {
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--pk-accent, #b0492e);
    margin: 0 0 14px;
  }
  .cmp-vs {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: stretch;
    gap: 12px;
    margin-top: 36px;
    max-width: 760px;
  }
  .cmp-panel {
    border: 1px solid var(--rule);
    border-radius: 14px;
    padding: 22px 22px 20px;
    background: var(--bg-2);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .cmp-us {
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--pink) 16%, var(--bg)) 0%,
      var(--bg) 100%
    );
    border-color: color-mix(in srgb, var(--pink) 55%, var(--rule));
    box-shadow: 0 18px 40px -28px rgba(28, 27, 24, 0.55);
  }
  .cmp-badge {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--ink);
  }
  .cmp-them .cmp-badge {
    color: var(--ink-soft);
  }
  .cmp-line {
    font-family: var(--serif);
    font-size: 18px;
    line-height: 1.35;
    margin: 0;
    color: var(--ink);
  }
  .cmp-them .cmp-line {
    color: var(--ink-soft);
  }
  .cmp-wedge {
    margin-top: auto;
    align-self: flex-start;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: var(--ink);
    color: var(--bg);
    padding: 5px 11px;
    border-radius: 999px;
  }
  .cmp-versus {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .cmp-versus span {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--bg);
    font-size: 13px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* ---- Comparison: table ---- */
  .prose :global(.comparison-scroll) {
    overflow-x: auto;
    margin: 28px 0;
    -webkit-overflow-scrolling: touch;
  }
  .prose :global(.comparison-table) {
    width: 100%;
    min-width: 540px;
    border-collapse: separate;
    border-spacing: 0;
    margin: 0;
    border: 1px solid var(--rule);
    border-radius: 12px;
    overflow: hidden;
    font-size: 15px;
    line-height: 1.45;
  }
  .prose :global(.comparison-table thead) {
    border: none;
  }
  .prose :global(.comparison-table th) {
    background: var(--ink);
    color: var(--bg);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 13px 16px;
    white-space: nowrap;
    border: none;
  }
  .prose :global(.comparison-table td) {
    padding: 13px 16px;
    border-bottom: 1px solid var(--rule);
    border-right: 1px solid var(--rule);
    vertical-align: top;
  }
  .prose :global(.comparison-table td:last-child) {
    border-right: none;
  }
  .prose :global(.comparison-table tbody tr:last-child td) {
    border-bottom: none;
  }
  .prose :global(.comparison-table tbody tr:nth-child(even) td) {
    background: color-mix(in srgb, var(--bg-2) 60%, var(--bg));
  }
  .prose :global(.comparison-table tr td:first-child) {
    font-weight: 600;
    font-size: 14px;
    white-space: normal;
  }
  .prose :global(.comparison-table th.col-us) {
    background: var(--pink);
    color: var(--ink);
  }
  .prose :global(.comparison-table td.col-us) {
    background: color-mix(in srgb, var(--pink) 14%, var(--bg)) !important;
    font-weight: 500;
    color: var(--ink);
    box-shadow:
      inset 1px 0 0 color-mix(in srgb, var(--pink) 45%, transparent),
      inset -1px 0 0 color-mix(in srgb, var(--pink) 45%, transparent);
  }

  /* ---- Comparison: dual CTA ---- */
  .cta-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .cta-btn--ghost {
    background: transparent;
    color: var(--bg);
    box-shadow: inset 0 0 0 1px rgba(246, 243, 236, 0.4);
  }
  .cta-btn--ghost:hover {
    background: rgba(246, 243, 236, 0.1);
  }

  @media (max-width: 900px) {
    .post-header {
      padding-top: 120px;
    }
    .cta-box {
      padding: 32px 24px;
    }
    .cmp-vs {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .cmp-versus span {
      width: 38px;
      height: 38px;
    }
  }
</style>
