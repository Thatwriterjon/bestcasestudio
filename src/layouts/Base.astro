---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface BreadcrumbItem {
  name: string;
  /** Absolute or root-relative URL. Root-relative paths are resolved against Astro.site. */
  url: string;
}

interface Props {
  title?: string;
  description?: string;
  /** When true, the nav starts transparent and only switches to its solid background once the
   * user scrolls past the hero. Used on the home page. */
  transparentNav?: boolean;
  /** When true, emits `<meta name="robots" content="noindex">`. Used on 404 and other pages
   * that should not be indexed. */
  noindex?: boolean;
  /** Optional additional JSON-LD blocks injected into the head, on top of the sitewide
   * Organization graph node. Each entry is a Schema.org object — it will be JSON-stringified
   * inside a `<script type="application/ld+json">` tag. */
  schema?: Record<string, unknown>[];
  /** When set, a BreadcrumbList JSON-LD node is emitted. Pass the trail from root to current
   * page; the current page itself is the last item. Omit on the home page. */
  breadcrumbs?: BreadcrumbItem[];
  /** Open Graph type. Defaults to 'website'; pass 'article' for case-study/example pages. */
  ogType?: string;
  /** Optional Twitter-specific overrides. When omitted, falls back to title/description. */
  twitterTitle?: string;
  twitterDescription?: string;
}

const {
  title = 'Best Case Studio — The Proof Kit: a complete B2B case study, $2,500',
  description = 'One conversation with your best customer becomes a complete B2B case study — video, written, and ready for everywhere your buyers look. $2,500, delivered 14 days from the interview.',
  transparentNav = false,
  noindex = false,
  schema = [],
  breadcrumbs,
  ogType = 'website',
  twitterTitle,
  twitterDescription,
} = Astro.props;

const siteOrigin = Astro.site ?? new URL('https://bestcasestud.io');
const canonical = new URL(Astro.url.pathname, siteOrigin).toString();
const ogImage = new URL('/og.jpg', siteOrigin).toString();

const organization = {
  '@type': 'Organization',
  '@id': 'https://bestcasestud.io/#org',
  name: 'Best Case Studio',
  url: 'https://bestcasestud.io/',
  logo: 'https://bestcasestud.io/favicon.svg',
  description: 'Two-person studio producing the Proof Kit — one recorded customer conversation turned into a complete B2B case study: video, written, and everywhere your buyers look.',
  founder: [
    {
      '@type': 'Person',
      '@id': 'https://bestcasestud.io/#jon',
      name: 'Jon McGreevy',
      jobTitle: 'Founder, Lead',
      worksFor: { '@id': 'https://bestcasestud.io/#org' },
      sameAs: [
        'https://jonmcgreevy.com',
        'https://www.linkedin.com/in/jonmcgreevy/',
        'https://jonmcgreevy.substack.com',
        'https://open.spotify.com/show/6mH42FJY0OA3CNiMAIj4cN',
        'https://podcasts.apple.com/us/podcast/saasy-as-f-k-podcast/id1573388272',
      ],
    },
    {
      '@type': 'Person',
      '@id': 'https://bestcasestud.io/#jessie',
      name: 'Jessie McGreevy',
      jobTitle: 'Operations',
      worksFor: { '@id': 'https://bestcasestud.io/#org' },
    },
  ],
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: 'customer service',
      email: 'jon@bestcasestud.io',
      areaServed: 'Worldwide',
      availableLanguage: ['English'],
    },
  ],
  sameAs: [
    'https://www.linkedin.com/in/jonmcgreevy/',
    'https://jonmcgreevy.substack.com',
    'https://www.youtube.com/@thebestcasestudio',
  ],
};

const breadcrumbSchema = breadcrumbs && breadcrumbs.length > 0
  ? {
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((b, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: b.name,
        item: new URL(b.url, siteOrigin).toString(),
      })),
    }
  : null;

const twTitle = twitterTitle ?? title;
const twDescription = twitterDescription ?? description;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/newsreader-latin-wght-normal.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/ibm-plex-mono-latin-500-normal.woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Best Case Studio — The Proof Kit: a complete B2B case study for $2,500." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={twTitle} />
    <meta name="twitter:description" content={twDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#f6f3ec" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <slot name="head" />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({ '@context': 'https://schema.org', ...organization })}
    />
    {breadcrumbSchema && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify({ '@context': 'https://schema.org', ...breadcrumbSchema })}
      />
    )}
    {schema.map((node) => (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify({ '@context': 'https://schema.org', ...node })}
      />
    ))}
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav transparent={transparentNav} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
